---
/**
 * The home page's short gold field "Bli fadder" (#bli-fadder), last in the content: the heading, the lede, a link to
 * the other ways to support us (/bli-fadder#fler) and an ink button to Stöd oss, where the visitor signs up. The mobile
 * dock goes with it and hides while the field shows.
 */
import BliFadderDocka from "@/components/BliFadderDocka.astro";
import Pil from "@/components/Pil.astro";
import TibebBand from "@/components/TibebBand.astro";
import { buttonVariants } from "@/components/ui/button";
import { href } from "@/lib/utils";
---

<TibebBand variant="thin" />

<section id="bli-fadder" aria-labelledby="bli-fadder-rubrik" class="bg-gold py-[clamp(64px,9vw,120px)] text-ink">
  <div class="band-inner flex flex-wrap items-end justify-between gap-x-14 gap-y-8">
    <div class="min-w-0 flex-[999_1_480px]">
      <h2 id="bli-fadder-rubrik" class="text-headline">Bli fadder och håll ljusen tända.</h2>
      <p class="mt-[22px] max-w-[52ch] text-lede">
        Som fadder stöttar du alla 20 fadderbarnen tillsammans. Ditt bidrag går till skolavgifter, uniform, skolmaterial
        och vård i Addis Abeba.
      </p>
      <p class="mt-5">
        Hellre en engångsgåva? <a
          class="inline-flex min-h-11 items-center font-semibold underline decoration-2 underline-offset-[0.22em]"
          href={href("/bli-fadder#fler")}>Fler sätt att stödja oss</a
        >
      </p>
    </div>
    <a class={buttonVariants({ variant: "ink" })} href={href("/bli-fadder")}>
      Bli fadder
      <Pil />
    </a>
  </div>
</section>

<BliFadderDocka />
