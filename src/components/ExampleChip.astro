---
import { cn } from "@/lib/utils";

/** The chip "Exempel" that marks an example post (Exempelinlägg). */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span
  class={cn(
    "inline-block rounded-sm border-2 border-dashed border-ink bg-white px-[9px] py-px text-label font-semibold text-ink",
    className,
  )}>Exempel</span
>
