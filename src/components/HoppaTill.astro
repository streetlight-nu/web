---
/**
 * The row of jump links to a page's sections, as pills in the green page header (Om föreningen, Vår historia,
 * the page Bli fadder). `etikett` names the navigation for screen readers; `class` places the row.
 */
interface Props {
  etikett: string;
  lankar: { namn: string; id: string }[];
  class?: string;
}
const { etikett, lankar, class: klass } = Astro.props;
---

<nav aria-label={etikett} class={klass}>
  <ul class="m-0 flex list-none flex-wrap gap-3 p-0">
    {
      lankar.map(({ namn, id }) => (
        <li>
          <a class="jump" href={`#${id}`}>
            {namn}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .jump {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border: 2px solid color-mix(in srgb, var(--color-cotton) 45%, transparent);
    border-radius: var(--radius-pill);
    color: var(--color-cotton);
    font-size: var(--text-label);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.3s var(--ease-light);
  }
  .jump:hover {
    border-color: var(--color-gold);
  }
</style>
