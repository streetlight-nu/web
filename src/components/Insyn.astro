---
/**
 * Insyn: the row of föreningsuppgifter under Små med flit on Bli fadder, so a visitor can check the association.
 * The labels, values and chips come from foreningsuppgifter.ts (see Uppgift). Meant for the green field.
 */
import Uppgift from "@/components/Uppgift.astro";
import { visaUppgift } from "@/lib/foreningsuppgifter";

const rader = (["organisationsnummer", "nittiokonto"] as const).map((namn) => ({ namn, ...visaUppgift(namn) }));
---

<section class="insyn" aria-labelledby="insyn-rubrik">
  <h3 id="insyn-rubrik" class="text-title tracking-[-0.015em] text-cotton">Insyn</h3>
  <dl>
    {
      rader.map(({ namn, etikett }) => (
        <div>
          <dt>{etikett}</dt>
          <dd><Uppgift namn={namn} /></dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .insyn {
    margin-top: 40px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 24px;
    align-items: baseline;
  }
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 32px;
  }
  dl > div {
    min-width: 0;
    border-top: 1.5px solid rgba(207, 227, 216, 0.3);
    padding-top: 12px;
  }
  dt {
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    color: var(--color-mint);
  }
  dd {
    margin: 6px 0 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 600px) {
    .insyn {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    /* The two short values stand side by side as long as the longest label fits, otherwise stacked. */
    dl {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.75rem), 1fr));
      gap: 12px 20px;
    }
  }
</style>
