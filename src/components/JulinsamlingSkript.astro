---
/**
 * Looks at the browser's date and lets the page follow the Julinsamling (src/lib/julinsamling.ts): it sets
 * `data-julinsamling` on <html> (the menu reads it) and swaps every `Julvaxel` whose built variant is the wrong one.
 *
 * Inline and at the end of the body, so that it runs before the page is first painted and before the scripts that
 * belong to what it swaps in. Under `astro dev` (the only place `fast` is set) the day can be chosen with `?dag=2026-12-28`;
 * it is kept for the rest of the tab's session, and `?dag=` with nothing after it clears it. It repeats the date test in `lageForDag` (src/lib/julperiod.ts), because an inline
 * script cannot import it; tests/e2e/julklapp.spec.ts covers the days around both dates.
 */
import { hamtaJulinsamling } from "@/lib/julinsamling";

const { start, slut, fast } = hamtaJulinsamling();
const config = { start: start ?? "", slut: slut ?? "", fast: fast ?? "" };
---

<script is:inline define:vars={{ config }}>
  (function () {
    var lage = config.fast;
    var idag = "";
    if (config.fast) {
      try {
        var valt = new URLSearchParams(location.search).get("dag");
        if (valt === null) valt = sessionStorage.getItem("julinsamlingDag") || "";
        else sessionStorage.setItem("julinsamlingDag", valt);
        if (/^\d{4}-\d{2}-\d{2}$/.test(valt)) idag = valt;
      } catch (e) {}
    }
    if (!lage || idag) {
      if (!config.start || !config.slut) lage = "ingen";
      else {
        idag = idag || new Intl.DateTimeFormat("sv-SE", { timeZone: "Europe/Stockholm" }).format(new Date());
        lage = idag < config.start ? "innan" : idag <= config.slut ? "pagar" : "avslutad";
      }
    }
    document.documentElement.dataset.julinsamling = lage;
    document.querySelectorAll("[data-julvaxel]").forEach(function (el) {
      if (el.dataset.nu === lage) return;
      var aktiv = el.querySelector(":scope > [data-aktiv]");
      var mall = el.querySelector(':scope > template[data-lage="' + lage + '"]');
      aktiv.replaceChildren(mall ? mall.content.cloneNode(true) : "");
      el.dataset.nu = lage;
    });
  })();
</script>
