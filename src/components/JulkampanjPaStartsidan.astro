---
/**
 * The Christmas campaign on the home page (#julklapp), right under the light band: a compact row on
 * green-deep that continues the band's line "20 barn, 20 ljus." into "Håll ljusen tända i jul".
 *
 * It must not compete with "Bli fadder": that stays the one gold button on the page (the Ett ljus rule),
 * so the campaign gets a line button and a smaller heading than the page's sections. Fadder is the regular
 * support, the julklapp a gift at Christmas.
 *
 * Julkänsla: an adventsljusstake whose foot is a woven tibeb band, where Swedish Advent meets the shemma cloth.
 * "Ljus" is both light and candle: as many candles burn as there have been Advent Sundays, and pointing at
 * "Ge en julklapp" lights the rest. The flames are drawn in the lamp's three hard gold steps.
 *
 * Seasonal: shown only while `visasPaStartsidan` is ticked in Pages CMS (src/data/julkampanj.json).
 * It only links to /julklapp and never loads Repejo (ADR 0003).
 */
import { buttonVariants } from "@/components/ui/button";
import { hamtaJulkampanj } from "@/lib/julkampanj";
import { cn, href } from "@/lib/utils";

const { visasPaStartsidan, sistaDag } = hamtaJulkampanj();
---

{
  visasPaStartsidan && (
    <section id="julklapp" aria-labelledby="julklapp-rubrik" class="on-green bg-green-deep text-cotton">
      <div class="band-inner">
        <div class="rad">
          {/* Adventsljusstaken: four candles on a woven tibeb foot. Lit by default (no JS, reduced motion);
              the script lights as many as there have been Advent Sundays, and the rest on hover over "Ge en julklapp". */}
          <div class="stake">
            <svg class="adventsljus" viewBox="0 0 180 104" aria-hidden="true" data-adventsljus>
              <g class="ljus" transform="translate(30 0)">
                <rect x="-7" y="44" width="14" height="46" rx="1.5" fill="#FBFBF8" />
                <path d="M0 44v-6" stroke="#CFE3D8" stroke-width="2" stroke-linecap="round" />
                <g class="laga">
                  <circle cx="0" cy="30" r="19" fill="#F4B400" opacity="0.12" />
                  <circle cx="0" cy="30" r="12.5" fill="#FFCF45" opacity="0.16" />
                  <path d="M0 12C5 20 8 26 8 31a8 8 0 0 1-16 0c0-5 3-11 8-19Z" fill="#F4B400" />
                  <path d="M0 20C3.5 25 5.5 29 5.5 32a5.5 5.5 0 0 1-11 0c0-3 2-7 5.5-12Z" fill="#FFCF45" />
                  <path d="M0 27C2 30 3 32 3 34a3 3 0 0 1-6 0c0-2 1-4 3-7Z" fill="#FFDB73" />
                </g>
              </g>
              <g class="ljus" transform="translate(70 0)">
                <rect x="-7" y="44" width="14" height="46" rx="1.5" fill="#FBFBF8" />
                <path d="M0 44v-6" stroke="#CFE3D8" stroke-width="2" stroke-linecap="round" />
                <g class="laga">
                  <circle cx="0" cy="30" r="19" fill="#F4B400" opacity="0.12" />
                  <circle cx="0" cy="30" r="12.5" fill="#FFCF45" opacity="0.16" />
                  <path d="M0 12C5 20 8 26 8 31a8 8 0 0 1-16 0c0-5 3-11 8-19Z" fill="#F4B400" />
                  <path d="M0 20C3.5 25 5.5 29 5.5 32a5.5 5.5 0 0 1-11 0c0-3 2-7 5.5-12Z" fill="#FFCF45" />
                  <path d="M0 27C2 30 3 32 3 34a3 3 0 0 1-6 0c0-2 1-4 3-7Z" fill="#FFDB73" />
                </g>
              </g>
              <g class="ljus" transform="translate(110 0)">
                <rect x="-7" y="44" width="14" height="46" rx="1.5" fill="#FBFBF8" />
                <path d="M0 44v-6" stroke="#CFE3D8" stroke-width="2" stroke-linecap="round" />
                <g class="laga">
                  <circle cx="0" cy="30" r="19" fill="#F4B400" opacity="0.12" />
                  <circle cx="0" cy="30" r="12.5" fill="#FFCF45" opacity="0.16" />
                  <path d="M0 12C5 20 8 26 8 31a8 8 0 0 1-16 0c0-5 3-11 8-19Z" fill="#F4B400" />
                  <path d="M0 20C3.5 25 5.5 29 5.5 32a5.5 5.5 0 0 1-11 0c0-3 2-7 5.5-12Z" fill="#FFCF45" />
                  <path d="M0 27C2 30 3 32 3 34a3 3 0 0 1-6 0c0-2 1-4 3-7Z" fill="#FFDB73" />
                </g>
              </g>
              <g class="ljus" transform="translate(150 0)">
                <rect x="-7" y="44" width="14" height="46" rx="1.5" fill="#FBFBF8" />
                <path d="M0 44v-6" stroke="#CFE3D8" stroke-width="2" stroke-linecap="round" />
                <g class="laga">
                  <circle cx="0" cy="30" r="19" fill="#F4B400" opacity="0.12" />
                  <circle cx="0" cy="30" r="12.5" fill="#FFCF45" opacity="0.16" />
                  <path d="M0 12C5 20 8 26 8 31a8 8 0 0 1-16 0c0-5 3-11 8-19Z" fill="#F4B400" />
                  <path d="M0 20C3.5 25 5.5 29 5.5 32a5.5 5.5 0 0 1-11 0c0-3 2-7 5.5-12Z" fill="#FFCF45" />
                  <path d="M0 27C2 30 3 32 3 34a3 3 0 0 1-6 0c0-2 1-4 3-7Z" fill="#FFDB73" />
                </g>
              </g>
              <rect x="2" y="88" width="176" height="16" fill="#0E4A38" />
              <path d="M2 89.5h176M2 102.5h176" stroke="#D64527" stroke-width="3" />
              <path d="M16 92l4 4-4 4-4-4zM36 92l4 4-4 4-4-4zM56 92l4 4-4 4-4-4zM76 92l4 4-4 4-4-4zM96 92l4 4-4 4-4-4zM116 92l4 4-4 4-4-4zM136 92l4 4-4 4-4-4zM156 92l4 4-4 4-4-4zM176 92l4 4-4 4-4-4z" fill="#F4B400" />
            </svg>
            <span class="advent text-label text-mint" data-advent hidden></span>
          </div>
          <h2 id="julklapp-rubrik" class="rubrik text-title tracking-[-0.015em]">Håll ljusen tända i jul</h2>
          <p class="ingress max-w-[60ch] text-mint">
            Ge en julklapp till barnen i Addis Abeba och glädj samtidigt någon du tycker om. Vi skickar ditt julkort i
            ditt namn på julaftonsmorgonen.
          </p>
          <div class="handling">
            <a class={cn(buttonVariants({ variant: "line" }), "whitespace-nowrap")} href={href("/julklapp")}>
              Ge en julklapp
              <svg viewBox="0 0 18 18" aria-hidden="true"
                ><path
                  d="M3 9h11M10 4.5 14.5 9 10 13.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </a>
            {sistaDag && <p class="text-mint">Sista dagen med kort: <strong class="font-semibold text-cotton">{sistaDag}</strong></p>}
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  // Advent: as many candles burn as there have been Advent Sundays, as in a Swedish home. Outside Advent all four burn.
  // The markup is fully lit; only the script puts candles out, and lights the lit ones one by one when they come into view.
  const stake = document.querySelector<SVGElement>("[data-adventsljus]");
  if (stake) {
    const ljus = [...stake.querySelectorAll<SVGGElement>(".ljus")];
    const idag = new Date();
    const ar = idag.getFullYear();
    const juldagen = new Date(ar, 11, 25);
    // The fourth Advent Sunday is the last Sunday before Christmas Day; the first is three weeks earlier.
    const fjarde = new Date(ar, 11, 25 - (juldagen.getDay() || 7));
    const forsta = new Date(ar, 11, fjarde.getDate() - 21);
    const dag = new Date(ar, idag.getMonth(), idag.getDate());
    const under = dag >= forsta && dag <= new Date(ar, 11, 24);
    const tanda = under ? Math.min(4, 1 + Math.floor((dag.getTime() - forsta.getTime()) / (7 * 864e5))) : 4;
    ljus.forEach((el, i) => el.classList.toggle("slackt", i >= tanda));
    if (under) {
      const etikett = document.querySelector<HTMLElement>("[data-advent]")!;
      const ordning = ["Första", "Andra", "Tredje", "Fjärde"][tanda - 1];
      const antal = ["ett ljus är tänt", "två ljus är tända", "tre ljus är tända", "fyra ljus är tända"][tanda - 1];
      etikett.textContent = `${ordning} advent, ${antal}.`;
      etikett.hidden = false;
    }
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
      const brinner = ljus.filter((el) => !el.classList.contains("slackt"));
      brinner.forEach((el) => el.classList.add("vantar"));
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          brinner.forEach((el, i) => setTimeout(() => el.classList.replace("vantar", "tands"), 300 + i * 420));
        },
        { threshold: 0.8 },
      );
      io.observe(stake);
      // Never leave a candle out that should burn.
      setTimeout(() => brinner.forEach((el) => el.classList.remove("vantar")), 6000);
    }
  }
</script>

<style>
  /* One row on wide screens: the card, the text, the action. The rule above ties it to the light band's line. */
  .rad {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      "kort rubrik handling"
      "kort ingress handling";
    align-items: center;
    column-gap: clamp(24px, 3vw, 40px);
    border-top: 1.5px solid rgba(207, 227, 216, 0.25);
    padding-block: clamp(28px, 3.5vw, 40px) clamp(32px, 4vw, 48px);
  }
  .stake {
    grid-area: kort;
    display: grid;
    justify-items: center;
    gap: 8px;
    width: 176px;
  }
  .adventsljus {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .advent {
    font-weight: 600;
    text-align: center;
    text-wrap: balance;
  }
  .laga {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transition:
      opacity 0.5s var(--ease-light),
      transform 0.5s var(--ease-light);
  }
  /* A candle that is out shows only its wick. Pointing at "Ge en julklapp" lights the rest: a julklapp keeps the lights on. */
  .slackt .laga,
  .vantar .laga {
    opacity: 0;
    transform: scale(0.4, 0.1);
  }
  .vantar .laga {
    transition: none;
  }
  .rad:has(.handling a:hover, .handling a:focus-visible) .slackt .laga {
    opacity: 1;
    transform: none;
  }
  /* The flame catches: a flicker, then it stands, like the lamp at dusk. */
  @keyframes tands {
    0% {
      opacity: 0;
      transform: scale(0.4, 0.1);
    }
    25% {
      opacity: 1;
      transform: scale(0.7, 0.6);
    }
    40% {
      opacity: 0.35;
      transform: scale(0.6, 0.4);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
  .tands .laga {
    animation: tands 0.9s var(--ease-light) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .laga {
      transition: none;
    }
  }
  .rubrik {
    grid-area: rubrik;
    align-self: end;
  }
  .ingress {
    grid-area: ingress;
    align-self: start;
    margin-top: 6px;
  }
  .handling {
    grid-area: handling;
    display: grid;
    justify-items: start;
    gap: 10px;
  }
  /* Narrow: the card beside the heading, the text and the button in full width under it. */
  @media (max-width: 900px) {
    .rad {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        "kort rubrik"
        "ingress ingress"
        "handling handling";
      column-gap: 20px;
    }
    .stake {
      width: 132px;
    }
    .rubrik {
      align-self: center;
    }
    .ingress {
      margin-top: 14px;
    }
    .handling {
      margin-top: 22px;
    }
  }
  @media (max-width: 520px) {
    .stake {
      width: 116px;
    }
    .handling,
    .handling a {
      width: 100%;
    }
  }
</style>
