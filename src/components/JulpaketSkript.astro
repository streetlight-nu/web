---
/**
 * Looks at the browser's date and lets the page follow Ge ett julpaket (src/lib/julpaketperiod.ts): it sets
 * `data-julpaket` and `data-julpaket-lank` on <html> (the menu reads the latter: its link is shown a week before and a week after) and swaps every `Julvaxel` whose built variant is the wrong one.
 *
 * Inline and at the end of the body, so that it runs before the page is first painted and before the scripts that
 * belong to what it swaps in. Under `astro dev` (the only place `fast` is set) the day can be chosen with `?dag=2026-12-28`;
 * it is kept for the rest of the tab's session, and `?dag=` with nothing after it clears it. It repeats the date test in `lageForDag` (src/lib/julpaketdatum.ts), because an inline
 * script cannot import it; tests/e2e/julpaket.spec.ts covers the days around both dates.
 */
import { hamtaJulpaketperiod } from "@/lib/julpaketperiod";

const { start, slut, lankFran, lankTill, fast } = hamtaJulpaketperiod();
const config = { start: start ?? "", slut: slut ?? "", lankFran: lankFran ?? "", lankTill: lankTill ?? "", fast: fast ?? "" };
---

<script is:inline define:vars={{ config }}>
  (function () {
    var lage = config.fast;
    var idag = "";
    if (config.fast) {
      try {
        var valt = new URLSearchParams(location.search).get("dag");
        if (valt === null) valt = sessionStorage.getItem("julpaketDag") || "";
        else sessionStorage.setItem("julpaketDag", valt);
        if (/^\d{4}-\d{2}-\d{2}$/.test(valt)) idag = valt;
      } catch (e) {}
    }
    var lank = !!config.fast;
    if (!lage || idag) {
      if (!config.start || !config.slut) {
        lage = "ingen";
        lank = false;
      } else {
        idag = idag || new Intl.DateTimeFormat("sv-SE", { timeZone: "Europe/Stockholm" }).format(new Date());
        lage = idag < config.start ? "innan" : idag <= config.slut ? "pagar" : "avslutad";
        lank = idag >= config.lankFran && idag <= config.lankTill;
      }
    }
    document.documentElement.dataset.julpaket = lage;
    document.documentElement.dataset.julpaketLank = lank ? "ja" : "nej";
    document.querySelectorAll("[data-julvaxel]").forEach(function (el) {
      if (el.dataset.nu === lage) return;
      var aktiv = el.querySelector(":scope > [data-aktiv]");
      var mall = el.querySelector(':scope > template[data-lage="' + lage + '"]');
      aktiv.replaceChildren(mall ? mall.content.cloneNode(true) : "");
      el.dataset.nu = lage;
    });
  })();
</script>
