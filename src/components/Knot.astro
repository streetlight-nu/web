---
import { amne, type Amne } from "@/lib/amnen";
import { cn } from "@/lib/utils";

/**
 * The topic knot on the gold thread (design system NewsItem): a gold diamond whose core
 * shows the topic, in the colour src/lib/amnen.ts gives it. Decorative: the topic is
 * always written out as well.
 */
interface Props {
  topic: Amne;
  class?: string;
}
const { topic, class: className } = Astro.props;
---

<span
  class={cn("knot", className)}
  data-amne={topic}
  style={`--knutfarg: ${amne(topic).knutfarg}`}
  aria-hidden="true"></span>

<style>
  .knot {
    position: relative;
    display: inline-block;
    flex: none;
    width: 16px;
    height: 16px;
    transform: rotate(45deg);
    background: var(--color-gold);
  }
  .knot::after {
    content: "";
    position: absolute;
    inset: 28%;
    background: var(--knutfarg);
  }
</style>
