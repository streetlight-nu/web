---
import FyllsI from "@/components/FyllsI.astro";

/**
 * Ledger: a list between thick ink rules, for what something is made of. Used instead of cards.
 * Each row has a woven rhombus marker (gold with a red, cobalt or green core, in turn).
 * A title or text the association has not written yet shows the chip "fylls i".
 */
export interface LedgerItem {
  title?: string;
  text?: string;
}
interface Props {
  items: LedgerItem[];
}
const { items } = Astro.props;
---

<ul class="ledger">
  {
    items.map((item) => (
      <li>
        <span class="mark" aria-hidden="true" />
        <div>
          <h3 class="mb-1.5 text-title tracking-[-0.015em]">{item.title ?? <FyllsI>rubrik fylls i</FyllsI>}</h3>
          <p class="max-w-[52ch] text-ink-soft">{item.text ?? <FyllsI>text fylls i</FyllsI>}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 3px solid var(--color-ink);
  }
  li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 20px;
    padding-block: 26px;
    border-bottom: 1.5px solid rgba(11, 46, 36, 0.18);
  }
  li:last-child {
    border-bottom: 3px solid var(--color-ink);
  }
  /* The woven marker: a gold rhombus with a core of red, cobalt or green thread, in turn. */
  .mark {
    --storlek: 28px;
    --karna: var(--color-thread-red);
    width: var(--storlek);
    height: var(--storlek);
    margin: 6px 0 0 6px;
    transform: rotate(45deg);
    background: var(--color-gold);
    box-shadow:
      inset 0 0 0 calc(var(--storlek) / 4) var(--color-gold),
      inset 0 0 0 calc(var(--storlek) / 2) var(--karna);
  }
  li:nth-child(3n + 2) .mark {
    --karna: var(--color-thread-cobalt);
  }
  li:nth-child(3n) .mark {
    --karna: var(--color-green);
  }
  /* On a phone the marker and its column shrink, so the text gets the width. */
  @media (max-width: 520px) {
    li {
      grid-template-columns: 30px minmax(0, 1fr);
      gap: 14px;
    }
    .mark {
      --storlek: 20px;
      margin: 6px 0 0 5px;
    }
  }
</style>
