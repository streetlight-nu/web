---
/**
 * Ledger: a list between thick ink rules, for what something is made of. Used instead of cards.
 * Each row has a woven rhombus marker (gold with a red, cobalt or green core).
 */
export interface LedgerItem {
  title: string;
  text: string;
}
interface Props {
  items: LedgerItem[];
}
const { items } = Astro.props;
---

<ul class="ledger">
  {
    items.map((item) => (
      <li>
        <span class="mark" aria-hidden="true" />
        <div>
          <h3 class="mb-1.5 text-title tracking-[-0.015em]">{item.title}</h3>
          <p class="max-w-[52ch] text-ink-soft">{item.text}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 3px solid var(--color-ink);
  }
  li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 20px;
    padding-block: 26px;
    border-bottom: 1.5px solid rgba(11, 46, 36, 0.18);
  }
  li:last-child {
    border-bottom: 3px solid var(--color-ink);
  }
  .mark {
    width: 28px;
    height: 28px;
    margin: 6px 0 0 6px;
    transform: rotate(45deg);
    background: var(--color-gold);
    box-shadow:
      inset 0 0 0 7px var(--color-gold),
      inset 0 0 0 14px var(--color-thread-red);
  }
  li:nth-child(2) .mark {
    box-shadow:
      inset 0 0 0 7px var(--color-gold),
      inset 0 0 0 14px var(--color-thread-cobalt);
  }
  li:nth-child(3) .mark {
    box-shadow:
      inset 0 0 0 7px var(--color-gold),
      inset 0 0 0 14px var(--color-green);
  }
</style>
