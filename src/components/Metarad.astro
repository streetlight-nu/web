---
import Knot from "@/components/Knot.astro";
import { amne, type Amne } from "@/lib/amnen";
import { formateraDatum, isoDatum } from "@/lib/nyheter";
import { cn } from "@/lib/utils";

/**
 * An inlägg's meta row: the topic's knot and name, and the date as <time>. Used in the list on
 * /nyheter (NewsItem), in "Senaste nytt" and at the top of an inlägg. Anything more, such as the
 * place, goes in the slot after the date.
 *
 * Each place sets its own look through the class props. In the list, the row is `contents`,
 * so that the topic and the date can sit in the row's own grid, with the knot on the thread.
 */
interface Props {
  amne: Amne;
  datum: Date;
  class?: string;
  amneClass?: string;
  knotClass?: string;
  datumClass?: string;
}
const { amne: varde, datum, class: className, amneClass, knotClass, datumClass } = Astro.props;
---

<div class={cn("flex flex-wrap items-center", className)}>
  <span class={cn("amne inline-flex items-center gap-3", amneClass)}>
    <Knot topic={varde} class={knotClass} />{amne(varde).namn}
  </span>
  <time class={cn("tabular-nums", datumClass)} datetime={isoDatum(datum)}>{formateraDatum(datum)}</time>
  <slot />
</div>
