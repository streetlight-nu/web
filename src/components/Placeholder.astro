---
import { cn } from "@/lib/utils";

/**
 * Photo placeholder (design system Placeholder, `sl-photo`): shown where the association
 * has not given a photo yet. The text says which photo should go here. Never use a made-up
 * photo instead. The styles live in global.css, so that a post's Markdown can use the
 * same markup: <div class="sl-photo"><span>Foto: …</span></div>.
 */
interface Props {
  text: string;
  class?: string;
}
const { text, class: className } = Astro.props;
---

<div class={cn("sl-photo", className)}><span>{text}</span></div>
