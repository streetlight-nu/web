---
/**
 * Repejo, embedded (ADR 0003): its script, its checkout and its progress bar towards the fundraising goal.
 * Everything Repejo-specific (host, organisation id, short code) lives here and in `src/lib/repejo.ts`.
 *
 * - `del="skript"`: Repejo's `checkout.js`, loaded with `defer`. Put it once per page, in the head.
 * - `del="checkout"`: `<repejo-checkout>`, with a reserved minimum height so the page does not jump.
 *   `vantar` says what the reserved space says (default: the julklapp's).
 * - `del="matare"`: `<repejo-progress-bar>`, the progress bar towards the goal, also with a reserved height.
 *
 * Until Repejo has defined an element (without JS, or when Repejo cannot be reached), the reserved space shows a
 * dashed frame saying what goes there. Repejo draws everything inside the elements: amounts, card fields and payment.
 */
import { JULKAMPANJ_KORTKOD, REPEJO_HOST, REPEJO_ORGANISATION } from "@/lib/repejo";

interface Props {
  del: "skript" | "checkout" | "matare";
  /** The campaign's short code at Repejo. */
  kortkod?: string;
  /** What the dashed frame says until Repejo has drawn the checkout. */
  vantar?: string;
}
const {
  del,
  kortkod = JULKAMPANJ_KORTKOD,
  vantar = "Här visas Repejos formulär för julklappen.",
} = Astro.props;
---

{
  del === "skript" && (
    <script
      is:inline
      defer
      type="text/javascript"
      src={`${REPEJO_HOST}/assets/checkout.js`}
      data-organisation-id={REPEJO_ORGANISATION}
      data-host={REPEJO_HOST}
    />
  )
}
{
  del === "checkout" && (
    <div class="repejo">
      <repejo-checkout short_code={kortkod} host={REPEJO_HOST} data-vantar={vantar} />
    </div>
  )
}
{
  del === "matare" && (
    <div class="repejo">
      <repejo-progress-bar short-code={kortkod} host={REPEJO_HOST} data-vantar="Här visas insamlingsmätaren." />
    </div>
  )
}

<style>
  .repejo {
    min-width: 0;
  }
  repejo-checkout,
  repejo-progress-bar {
    display: block;
    min-width: 0;
  }
  /* Room for Repejo's elements before Repejo draws them, so the page does not jump when they appear. */
  repejo-checkout {
    min-height: 480px;
  }
  repejo-progress-bar {
    min-height: 56px;
  }
  /* Until Repejo has defined an element, its reserved space says what goes there. */
  repejo-checkout:not(:defined),
  repejo-progress-bar:not(:defined) {
    padding: 16px 20px;
    border: 2px dashed currentColor;
    border-radius: var(--radius-lg);
  }
  repejo-checkout:not(:defined)::before,
  repejo-progress-bar:not(:defined)::before {
    content: attr(data-vantar);
  }
</style>
