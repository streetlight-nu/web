---
/**
 * Repejo, embedded (ADR 0003): its script, its checkout and its progress bar towards the fundraising goal.
 * Everything Repejo-specific (host, organisation id, short code) lives here and in `src/lib/repejo.ts`.
 *
 * - `del="skript"`: Repejo's `checkout.js`, loaded with `defer`. Put it once per page, in the head.
 * - `del="checkout"`: `<repejo-checkout>`, with a reserved minimum height so the page does not jump.
 *   `vantar` and `reservtext` say what the reserved space and the fallback link say (default: the julklapp's).
 * - `del="matare"`: `<repejo-progress-bar>`, the progress bar towards the goal, also with a reserved height.
 *
 * Under each element there is a small link to the campaign's own page at Repejo, so a visitor can give even
 * when Repejo fails, also after it has defined its elements. `utanReserv` leaves the link out under the
 * checkout (off by default). Until Repejo has defined an element
 * (without JS, or when Repejo cannot be reached), the reserved space shows a dashed frame saying what goes
 * there. Repejo draws everything inside the elements: amounts, card fields and payment.
 */
import { JULKAMPANJ_KORTKOD, REPEJO_HOST, REPEJO_ORGANISATION, kampanjsida } from "@/lib/repejo";

interface Props {
  del: "skript" | "checkout" | "matare";
  /** The campaign's short code at Repejo. */
  kortkod?: string;
  /** What the dashed frame says until Repejo has drawn the checkout. */
  vantar?: string;
  /** The fallback link's text under the checkout. */
  reservtext?: string;
  /** Leaves out the fallback link under the checkout. The reserved space and its dashed frame stay. */
  utanReserv?: boolean;
}
const {
  del,
  kortkod = JULKAMPANJ_KORTKOD,
  vantar = "Här visas Repejos formulär för julklappen.",
  reservtext = "Ge via Repejos kampanjsida",
  utanReserv = false,
} = Astro.props;
const reserv = kampanjsida(kortkod);
---

{
  del === "skript" && (
    <script
      is:inline
      defer
      type="text/javascript"
      src={`${REPEJO_HOST}/assets/checkout.js`}
      data-organisation-id={REPEJO_ORGANISATION}
      data-host={REPEJO_HOST}
    />
  )
}
{
  del === "checkout" && (
    <div class="repejo">
      <repejo-checkout short_code={kortkod} host={REPEJO_HOST} data-vantar={vantar} />
      {!utanReserv && (
        <p class="reserv">
          Fungerar inte betalningen? <a href={reserv}>{reservtext}</a>
        </p>
      )}
    </div>
  )
}
{
  del === "matare" && (
    <div class="repejo">
      <repejo-progress-bar short-code={kortkod} host={REPEJO_HOST} data-vantar="Här visas insamlingsmätaren." />
    </div>
  )
}

<style>
  .repejo {
    min-width: 0;
  }
  repejo-checkout,
  repejo-progress-bar {
    display: block;
    min-width: 0;
  }
  /* Room for Repejo's elements before Repejo draws them, so the page does not jump when they appear. */
  repejo-checkout {
    min-height: 480px;
  }
  repejo-progress-bar {
    min-height: 56px;
  }
  /* Until Repejo has defined an element, its reserved space says what goes there. */
  repejo-checkout:not(:defined),
  repejo-progress-bar:not(:defined) {
    padding: 16px 20px;
    border: 2px dashed currentColor;
    border-radius: var(--radius-lg);
  }
  repejo-checkout:not(:defined)::before,
  repejo-progress-bar:not(:defined)::before {
    content: attr(data-vantar);
  }
  .reserv {
    margin-top: 8px;
  }
  .reserv a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-weight: 600;
    color: inherit;
    text-decoration: underline;
  }
</style>
