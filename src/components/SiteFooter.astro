---
import Logo from "@/components/Logo.astro";
import FyllsI from "@/components/FyllsI.astro";
import TibebBand from "@/components/TibebBand.astro";
import { buttonVariants } from "@/components/ui/button";
import { hamtaForeningsuppgifter } from "@/lib/foreningsuppgifter";
import { href } from "@/lib/utils";

const year = new Date().getFullYear();
const { organisationsnummer } = hamtaForeningsuppgifter();

// Footer links: a full 44 px row each, underline in soft gold on hover (the design system's link hover).
const link =
  "flex min-h-11 w-fit items-center decoration-gold-soft underline-offset-[0.22em] hover:text-cotton hover:underline";
---

<footer class="on-green bg-green-deep text-body text-mint">
  <TibebBand />
  <div
    class="band-inner grid grid-cols-1 gap-y-12 pt-14 pb-12 min-[521px]:grid-cols-2 min-[521px]:gap-x-10 min-[901px]:grid-cols-[minmax(0,1.3fr)_repeat(2,minmax(0,1fr))] min-[901px]:gap-x-14"
  >
    <div class="min-w-0 min-[521px]:col-span-2 min-[901px]:col-span-1">
      <Logo on="green" href={href("/")} class="-mt-1.5 mb-4" />
      <p class="max-w-[46ch]">
        Ideell förening i Sverige och Etiopien som stöttar 20 fadderbarns skolgång och deras familjer i Addis Abeba.
      </p>
      <p class="mt-6 text-label">
        <span class="block text-[2.2rem] leading-tight text-gold" lang="am">ብርሃን</span>
        ”ljus” på amhariska, uttalas birhan
      </p>
    </div>

    <div class="min-w-0">
      <h2 class="mb-3 text-[1.1rem] tracking-[-0.01em] text-cotton">Stöd oss</h2>
      <p class="max-w-[30ch]">Som fadder stöttar du alla 20 fadderbarnen tillsammans.</p>
      <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2">
        <a class={buttonVariants({ variant: "line", size: "small" })} href={href("/stod-oss")}>Bli fadder</a>
        <a class={link} href={href("/stod-oss#fler")}>Swisha en gåva</a>
      </div>
    </div>

    <nav class="min-w-0" aria-labelledby="sidfot-webbplatsen">
      <h2 id="sidfot-webbplatsen" class="mb-1 text-[1.1rem] tracking-[-0.01em] text-cotton">Webbplatsen</h2>
      <ul class="m-0 list-none p-0">
        <li><a class={link} href={href("/om-foreningen")}>Om oss</a></li>
        <li><a class={link} href={href("/om-foreningen#kontakt")}>Kontakt</a></li>
        <li><a class={link} href={href("/nyheter")}>Nyheter</a></li>
        <li><a class={link} href={href("/vanliga-fragor")}>Vanliga frågor</a></li>
      </ul>
    </nav>
  </div>
  <div class="band-inner">
    <div class="flex flex-wrap justify-between gap-4 border-t border-mint/20 pt-6 pb-8 text-label">
      <p>© {year} Streetlight Sverige</p>
      <p data-testid="sidfot-orgnr">Org.nr {organisationsnummer ?? <FyllsI>nummer fylls i</FyllsI>}</p>
    </div>
  </div>
</footer>
