---
import Logo from "@/components/Logo.astro";
import MainNav, { type NavLink } from "@/components/MainNav";
import { hamtaFunktioner } from "@/lib/funktioner";
import { hamtaJulkampanj } from "@/lib/julkampanj";
import { href } from "@/lib/utils";

/** The page the visitor is on, when it has its own place in the main menu or is where "Bli fadder" leads. */
export type AktuellSida = "start" | "nyheter" | "om" | "historia" | "julklapp" | "fragor" | "stod" | "engagera";

interface Props {
  current?: AktuellSida;
}
const { current } = Astro.props;
const { visasPaStartsidan } = hamtaJulkampanj();
const { julklapp, engagera } = hamtaFunktioner();

const links: NavLink[] = [
  // Vår historia is reached from Om föreningen (Så började det).
  { label: "Om oss", href: href("/om-foreningen"), current: current === "om" || current === "historia" },
  { label: "Nyheter", href: href("/nyheter"), current: current === "nyheter" },
  // The flag `engagera` (src/data/funktioner.json) removes the page and every link to it.
  ...(engagera ? [{ label: "Engagera dig", href: href("/engagera-dig"), current: current === "engagera" }] : []),
  // Seasonal: the association turns the campaign on and off in Pages CMS (src/data/julkampanj.json). The flag
  // `julklapp` (src/data/funktioner.json) removes the page and every link to it.
  ...(julklapp && (visasPaStartsidan || current === "julklapp")
    ? [{ label: "Ge en julklapp", href: href("/julklapp"), current: current === "julklapp" }]
    : []),
];
// The Ett ljus rule: on the campaign page "Ge en julklapp" is the gold button, and on the start page the hero's own
// "Bli fadder" is, so the header's "Bli fadder" steps back to a line on both.
// On the page Bli fadder the visitor is already where "Bli fadder" leads, so it is a line marked as the current page.
const sponsor = current === "stod" ? "current" : current === "julklapp" || current === "start" ? "line" : "gold";
---

<header class="on-green bg-green text-cotton">
  <div class="band-inner">
    <nav aria-label="Huvudmeny" class="flex flex-wrap items-center justify-between gap-3 py-[22px] min-[901px]:flex-nowrap min-[901px]:gap-[clamp(16px,2vw,24px)] max-[520px]:gap-2">
      <Logo on="green" href={href("/")} />
      <MainNav
        client:load
        links={links}
        sponsorHref={href("/bli-fadder")}
        sponsor={sponsor}
      />
    </nav>
    <slot />
  </div>
  <slot name="after" />
</header>
