---
/**
 * Steps (design system Steps): numbered steps for a real order, the number in an ink rhombus.
 * Use only when the order matters, e.g. "Så går det till". Works on cotton and on gold.
 * Put one <li> per step in the default slot. Give the list a name with aria-labelledby.
 */
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"ol">;
const { class: className, ...props } = Astro.props;
---

<ol class:list={["sl-steps", className]} {...props}><slot /></ol>

<style>
  .sl-steps {
    list-style: none;
    counter-reset: step;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .sl-steps :global(li) {
    counter-increment: step;
    position: relative;
    padding-left: 46px;
    min-height: 30px;
    text-wrap: pretty;
  }
  .sl-steps :global(li)::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 2px;
    width: 22px;
    height: 22px;
    transform: rotate(45deg);
    background: var(--color-ink);
  }
  .sl-steps :global(li)::after {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 1px;
    width: 32px;
    text-align: center;
    font-weight: 600;
    font-size: var(--text-label);
    color: var(--color-gold);
    font-variant-numeric: tabular-nums;
  }
</style>
