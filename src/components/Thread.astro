---
/**
 * Thread: the gold thread, a dashed gold line that binds a sequence together with a gold rhombus at each step.
 * Used on a green field.
 * Motion: while reading, the gold fills in behind the dashes and each step lights up as the reader reaches it.
 * It is an addition: the markup is the complete thread, and only the script switches it to tracking
 * (never with reduced motion or without JS).
 */
interface Props {
  steps: string[];
}
const { steps } = Astro.props;
---

<div class="thread" data-thread>
  {steps.map((step) => <p class="step">{step}</p>)}
</div>

<style>
  .thread {
    position: relative;
    padding: 34px 0 34px 34px;
  }
  .thread::before {
    content: "";
    position: absolute;
    left: 8px;
    top: 0;
    bottom: 0;
    width: 3px;
    background: repeating-linear-gradient(180deg, var(--color-gold) 0 14px, transparent 14px 22px);
  }
  /* The solid gold that fills in while reading; only shown when tracking. */
  .thread::after {
    content: "";
    position: absolute;
    left: 8px;
    top: 0;
    width: 3px;
    height: 100%;
    background: var(--color-gold);
    transform-origin: top;
    transform: scaleY(var(--p, 0));
    display: none;
  }
  /* On a phone the thread runs a shorter way past the first and the last step. */
  @media (max-width: 520px) {
    .thread {
      padding-block: 20px;
    }
  }
  .step {
    position: relative;
    color: var(--color-cotton);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.4rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .step + .step {
    margin-top: 20px;
  }
  .step::before {
    content: "";
    position: absolute;
    left: -33px;
    top: 0.32em;
    width: 13px;
    height: 13px;
    transform: rotate(45deg);
    background: var(--color-gold);
    transition:
      background-color 0.5s var(--ease-light),
      box-shadow 0.5s var(--ease-light);
  }
  .tracking::after {
    display: block;
  }
  .tracking .step {
    transition: color 0.5s var(--ease-light);
  }
  .tracking .step:not(.lit) {
    color: var(--color-mint);
  }
  .tracking .step::before {
    background: var(--color-green);
    box-shadow: inset 0 0 0 2px var(--color-gold);
  }
  .tracking .step.lit::before {
    background: var(--color-gold);
    box-shadow: none;
  }
  /* Going unlit is instant (never a visible fade-out); only lighting up is animated. */
  .tracking .step:not(.lit),
  .tracking .step:not(.lit)::before {
    transition: none;
  }
</style>

<script>
  // The gold fills in up to a reading line 62 % down the viewport; steps above that line are lit.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const thread of document.querySelectorAll<HTMLElement>("[data-thread]")) {
      const steps = thread.querySelectorAll<HTMLElement>(".step");
      let ticking = false;
      const update = () => {
        ticking = false;
        const r = thread.getBoundingClientRect();
        const line = window.innerHeight * 0.62;
        const p = Math.min(1, Math.max(0, (line - r.top) / r.height));
        thread.style.setProperty("--p", p.toFixed(3));
        steps.forEach((step) => step.classList.toggle("lit", step.getBoundingClientRect().top < line));
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };
      thread.classList.add("tracking");
      // Listen all the time (once per frame at most): a jump past the thread, e.g. via an anchor, must light it too.
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    }
  }
</script>
