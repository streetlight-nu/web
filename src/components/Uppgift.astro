---
/**
 * One föreningsuppgift's value, as foreningsuppgifter.ts decides it should be shown: the text, a link when the
 * uppgift is one (e-mail, the annual report, the social networks), or the chip that says what is missing.
 * The label is the caller's to place, from `visaUppgift(namn).etikett`, since a list and a sentence put it
 * differently. `lankklass` styles the link for the surface, and `lanktext` replaces the link's text where the
 * context needs it (e.g. "Följ oss på Facebook"). The social networks get their drawn icon before the text.
 */
import FyllsI from "@/components/FyllsI.astro";
import Ikon from "@/components/Ikon.astro";
import { type Foreningsuppgifter, type Uppgift, visaUppgift } from "@/lib/foreningsuppgifter";

interface Props {
  namn: Uppgift;
  /** The föreningsuppgifter to show; by default the data file's. */
  uppgifter?: Foreningsuppgifter;
  lankklass?: string;
  lanktext?: string;
}

const { namn, uppgifter, lankklass, lanktext } = Astro.props;
const { text, lank, saknas } = visaUppgift(namn, uppgifter);
const ikon = namn === "facebook" || namn === "instagram" ? namn : undefined;
---

{
  text === undefined ? (
    <FyllsI>{saknas}</FyllsI>
  ) : lank ? (
    <a class={lankklass} href={lank}>
      {ikon && <Ikon namn={ikon} />}
      {lanktext ?? text}
    </a>
  ) : (
    text
  )
}
