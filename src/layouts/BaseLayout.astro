---
import "@/styles/global.css";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { href } from "@/lib/utils";

/** The image a shared link shows (og:image). Without one, the site's standard image is used. */
export interface Delningsbild {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  title: string;
  description: string;
  current?: "nyheter";
  /** Open Graph's type: a post (Inlägg) is an "article", every other page a "website". */
  ogType?: "website" | "article";
  delningsbild?: Delningsbild;
}
const { title, description, current, ogType = "website", delningsbild } = Astro.props;
const pageTitle = title === "Streetlight" ? title : `${title} | Streetlight`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The standard image, drawn by scripts/rita-delningsbild.mjs from the logo on green.
const bild: Delningsbild = delningsbild ?? {
  src: href("/delningsbild.png"),
  alt: "Streetlight: Ett ljus på vägen till skolan.",
  width: 1200,
  height: 630,
};
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
    <meta name="theme-color" content="#0E4A38" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="Streetlight" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(bild.src, Astro.site)} />
    <meta property="og:image:width" content={String(bild.width)} />
    <meta property="og:image:height" content={String(bild.height)} />
    <meta property="og:image:alt" content={bild.alt} />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="absolute -top-16 left-3 z-30 rounded-pill bg-gold px-[18px] py-3 font-semibold text-ink no-underline focus:top-3"
      >Hoppa till innehållet</a
    >
    <SiteHeader current={current}>
      <slot name="header" />
      <slot name="header-after" slot="after" />
    </SiteHeader>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  /* Let the menu island take part in the header's flex layout. */
  astro-island {
    display: contents;
  }
</style>
