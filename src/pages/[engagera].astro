---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FyllsI from "@/components/FyllsI.astro";
import Kategoriikon from "@/components/Kategoriikon.astro";
import Pil from "@/components/Pil.astro";
import Repejo from "@/components/Repejo.astro";
import TibebBand from "@/components/TibebBand.astro";
import { buttonVariants } from "@/components/ui/button";
import { hamtaFunktioner } from "@/lib/funktioner";
import { href } from "@/lib/utils";

/** The page is built only when the flag `engagera` is on (src/data/funktioner.json); otherwise /engagera-dig is a 404. */
export function getStaticPaths() {
  return hamtaFunktioner().engagera ? [{ params: { engagera: "engagera-dig" } }] : [];
}

/**
 * Engagera dig: what members and others can do for Streetlight with their time. A green top with the two ways as
 * jump links, then one's own fundraiser through Repejo (ADR 0003): the occasions with their icons and one Repejo button
 * `<repejo-p2p-create-button>` without a category, so Repejo's own dialog asks which; last, tips and material for
 * finding new fadder. The printed material the association has not given yet shows the chip "fylls i".
 */

/** The two ways, in the order the sections come. */
const vagar = [
  { id: "insamling", rubrik: "Starta en egen insamling", text: "För en födelsedag, ett jubileum eller ett sportevent." },
  { id: "faddrar", rubrik: "Hjälp oss hitta nya faddrar", text: "Tips och material för att berätta om Streetlight." },
];

/** The occasions, each with an icon. Repejo's own dialog asks which one when the visitor starts a fundraiser. */
const tillfallen: { rubrik: string; text: string; ikon: "tarta" | "hjarta" | "pokal" }[] = [
  {
    rubrik: "Födelsedag",
    text: "Fyller du år? Be om gåvor till barnens skolgång.",
    ikon: "tarta",
  },
  {
    rubrik: "Jubileum",
    text: "En bröllopsdag, eller ett jubileum för ett företag eller en förening.",
    ikon: "hjarta",
  },
  {
    rubrik: "Sportevent",
    text: "Springer, cyklar eller simmar du? Låt vännerna heja med en gåva.",
    ikon: "pokal",
  },
];

/** The printed and digital material; the association makes it, and until then each row shows "fylls i". */
const material = [
  { rubrik: "Affisch att sätta upp", text: "För anslagstavlan på jobbet, i kyrkan eller i tvättstugan.", saknas: "affisch fylls i" },
  { rubrik: "Folder att dela ut", text: "Att lämna efter en pratstund, så att det finns något att läsa i lugn och ro.", saknas: "folder fylls i" },
  { rubrik: "Bilder för sociala medier", text: "Bilder och omslagsbilder till egna insamlingar.", saknas: "bilder fylls i" },
];

/** What a member can say about Streetlight, all from PRODUCT.md. */
const berattelse = [
  "Vi är små med flit. Det är 20 barn, och föreningen känner varje familj.",
  "En fadder stöttar alla 20 barnens skolgång tillsammans. Det går också att vara fadder för ett barn.",
  "Barnen väljs ut tillsammans med de lokala myndigheterna i Addis Abeba.",
  "Två föreningar med var sin styrelse. Streetlight Sverige samlar in, och Streetlight Etiopien bär arbetet på plats.",
];

const markorer = ["", "mark--cobalt", "mark--gron"];
---

<BaseLayout
  title="Engagera dig"
  current="engagera"
  description="Stötta barnen i Addis Abeba på fler sätt än som fadder: starta en egen insamling eller hjälp oss att hitta nya faddrar."
>
  <Repejo slot="head" del="skript" />

  <div slot="header" class="pt-[clamp(8px,2vw,20px)]">
    <nav aria-label="Du är här" class="flex flex-wrap items-center gap-2.5 text-label font-semibold text-mint">
      <a class="inline-flex min-h-11 items-center text-mint hover:text-cotton" href={href("/")}>Startsidan</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page" class="text-cotton">Engagera dig</span>
    </nav>
  </div>

  <section
    id="engagera"
    aria-labelledby="engagera-rubrik"
    class="on-green bg-green pt-[clamp(24px,4vw,56px)] pb-[clamp(64px,9vw,112px)] text-cotton"
  >
    <div class="split split--botten band-inner">
      <div class="min-w-0">
        <h1 id="engagera-rubrik" class="max-w-[14ch] text-headline">
          Engagera dig och håll <span class="text-gold">ljusen</span> tända.
        </h1>
        <p class="mt-[22px] max-w-[46ch] text-lede text-mint">
          Du kan stötta barnen i Addis Abeba på fler sätt än som fadder. Samla in pengar när du fyller år eller
          springer ett lopp, eller hjälp oss att hitta nya faddrar.
        </p>
      </div>
      <nav aria-label="Sätt att engagera dig" class="vagar min-w-0">
        <ul>
          {
            vagar.map((vag) => (
              <li>
                <a href={`#${vag.id}`}>
                  <span class="min-w-0">
                    <span class="vag-rubrik block text-title tracking-[-0.015em] text-cotton">{vag.rubrik}</span>
                    <span class="mt-1.5 block text-mint">{vag.text}</span>
                  </span>
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="size-6 flex-none">
                    <path
                      d="M12 5v14M6 13l6 6 6-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  <TibebBand variant="thin" />

  <section id="insamling" aria-labelledby="insamling-rubrik" class="bg-cotton py-[clamp(64px,9vw,120px)] text-ink">
    <div class="insamling band-inner">
      <div class="insamling-text min-w-0">
        <h2 id="insamling-rubrik" class="text-headline">Starta en egen insamling.</h2>
        <p class="mt-[22px] max-w-[46ch] text-lede text-ink-soft">
          Önska dig gåvor till barnen i stället för presenter. Skapa insamlingen och dela länken med vänner och familj. Det tar några minuter.
        </p>
      </div>
      <ul class="tillfallen" aria-label="Tillfällen att samla in till">
        {
          tillfallen.map((t) => (
            <li data-tillfalle={t.rubrik}>
              <Kategoriikon namn={t.ikon} class="size-11 text-ink max-[520px]:size-[30px]" />
              <div class="min-w-0">
                <h3 class="text-title tracking-[-0.015em]">{t.rubrik}</h3>
                <p class="mt-1.5 max-w-[44ch] text-ink-soft">{t.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="insamling-knapp min-w-0">
        <Repejo del="skapa-insamling" />
      </div>
    </div>
  </section>

  <TibebBand variant="thin" />

  <section id="faddrar" aria-labelledby="faddrar-rubrik" class="bg-cotton py-[clamp(64px,9vw,120px)] text-ink">
    <div class="split band-inner">
      <div class="min-w-0">
        <h2 id="faddrar-rubrik" class="text-headline">Hjälp oss hitta nya faddrar.</h2>
        <p class="mt-[22px] max-w-[46ch] text-lede text-ink-soft">
          Ett tips från en vän väger tyngre än en annons. Här är det du behöver för att berätta om Streetlight, vid
          köksbordet, på jobbet eller i föreningen.
        </p>
        <div class="on-green mt-[clamp(32px,4vw,48px)] rounded-md bg-green p-[clamp(24px,4vw,40px)] text-cotton">
          <h3 id="beratta" class="text-title tracking-[-0.015em]">Så kan du berätta</h3>
          <ul class="berattelse mt-5" aria-labelledby="beratta">
            {berattelse.map((rad) => <li>{rad}</li>)}
          </ul>
          <p class="mt-6 border-t border-mint/35 pt-5 text-mint">
            Får du en fråga du inte kan svara på? Tipsa om{" "}
            <a
              class="inline-block py-2.5 font-semibold text-cotton underline decoration-gold decoration-2 underline-offset-4"
              href={href("/vanliga-fragor")}>Vanliga frågor</a
            >.
          </p>
        </div>
      </div>
      <ul class="rader min-w-0" aria-label="Material">
        <li>
          <span class="mark" aria-hidden="true"></span>
          <div class="rad">
            <div class="min-w-0">
              <h3 class="text-title tracking-[-0.015em]">Sidan Bli fadder</h3>
              <p class="mt-1.5 max-w-[44ch] text-ink-soft">
                Där står allt en blivande fadder behöver, och formuläret för att anmäla sig. Dela länken.
              </p>
            </div>
            <div class="handling">
              <a class={buttonVariants({ variant: "line-ink" })} href={href("/bli-fadder")}>Till Bli fadder <Pil /></a>
            </div>
          </div>
        </li>
        {
          material.map((m, i) => (
            <li>
              <span class:list={["mark", markorer[(i + 1) % 3]]} aria-hidden="true" />
              <div class="rad">
                <div class="min-w-0">
                  <h3 class="text-title tracking-[-0.015em]">{m.rubrik}</h3>
                  <p class="mt-1.5 max-w-[44ch] text-ink-soft">{m.text}</p>
                </div>
                <div class="handling">
                  <FyllsI>{m.saknas}</FyllsI>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* A section's heading in the left column, its content in the right one; stacked under 900 px. */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: start;
    gap: clamp(32px, 6vw, 96px);
  }
  .split--botten {
    align-items: end;
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* The ways: a Ledger on green of jump links. */
  .vagar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-block: 3px solid var(--color-cotton);
  }
  .vagar li + li {
    border-top: 1.5px solid color-mix(in srgb, var(--color-mint) 35%, transparent);
  }
  .vagar a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 22px;
    color: var(--color-cotton);
    text-decoration: none;
  }
  .vagar a:hover .vag-rubrik {
    text-decoration: underline;
    text-decoration-color: var(--color-gold-soft);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  /* Starta en egen insamling: the text and its steps, then the button, on the left; the occasions on the right.
     Under 900 px the occasions come before the button, so the visitor has seen them when they start. */
  .insamling {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    grid-template-areas:
      "text tillfallen"
      "knapp tillfallen";
    /* The text row is as tall as the text, so the button sits right under the intro; the taller list on the right
       takes its extra height from the button's row. */
    grid-template-rows: auto 1fr;
    align-items: start;
    column-gap: clamp(32px, 6vw, 96px);
    row-gap: clamp(28px, 3vw, 36px);
  }
  .insamling-text {
    grid-area: text;
  }
  .insamling-knapp {
    grid-area: knapp;
  }
  @media (max-width: 900px) {
    .insamling {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "text"
        "tillfallen"
        "knapp";
      grid-template-rows: none;
    }
  }

  /* The occasions: rows as in Ledger, between thick ink rules, with the icon in the marker column. */
  .tillfallen {
    grid-area: tillfallen;
    list-style: none;
    margin: 0;
    padding: 0;
    border-block: 3px solid var(--color-ink);
  }
  .tillfallen li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 20px;
    padding-block: 24px;
  }
  .tillfallen li + li {
    border-top: 1.5px solid rgba(11, 46, 36, 0.18);
  }
  @media (max-width: 520px) {
    .tillfallen li {
      grid-template-columns: 30px minmax(0, 1fr);
      gap: 14px;
    }
  }

  /* Rows as in Ledger: thick ink rules top and bottom, a woven marker, the text and an action. */
  .rader {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 3px solid var(--color-ink);
  }
  .rader li {
    --markorspalt: 44px;
    --markorluft: 20px;
    display: grid;
    grid-template-columns: var(--markorspalt) minmax(0, 1fr);
    gap: var(--markorluft);
    padding-block: 26px;
    border-bottom: 1.5px solid rgba(11, 46, 36, 0.18);
  }
  .rader li:last-child {
    border-bottom: 3px solid var(--color-ink);
  }
  .rad {
    display: grid;
    gap: 16px;
  }
  .handling {
    min-width: 0;
  }

  /* The woven rhombus marker, as in Ledger. */
  .mark {
    --storlek: 28px;
    --karna: var(--color-thread-red);
    width: var(--storlek);
    height: var(--storlek);
    margin: 6px 0 0 6px;
    transform: rotate(45deg);
    background: var(--color-gold);
    box-shadow:
      inset 0 0 0 calc(var(--storlek) / 4) var(--color-gold),
      inset 0 0 0 calc(var(--storlek) / 2) var(--karna);
  }
  .mark--cobalt {
    --karna: var(--color-thread-cobalt);
  }
  .mark--gron {
    --karna: var(--color-green);
  }
  @media (max-width: 520px) {
    .rader li {
      --markorspalt: 30px;
      --markorluft: 14px;
    }
    .mark {
      --storlek: 20px;
      margin: 6px 0 0 5px;
    }
  }

  /* Så kan du berätta: gold rhombi on green, as the markers on the gold thread. */
  .berattelse {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .berattelse li {
    position: relative;
    padding-left: 34px;
    text-wrap: pretty;
  }
  .berattelse li::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 0.45em;
    width: 13px;
    height: 13px;
    transform: rotate(45deg);
    background: var(--color-gold);
  }
</style>
