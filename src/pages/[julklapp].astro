---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FyllsI from "@/components/FyllsI.astro";
import LightBand from "@/components/LightBand.astro";
import Pil from "@/components/Pil.astro";
import Repejo from "@/components/Repejo.astro";
import Steps from "@/components/Steps.astro";
import { hamtaFunktioner } from "@/lib/funktioner";
import { buttonVariants } from "@/components/ui/button";
import { hamtaJulkampanj } from "@/lib/julkampanj";
import { href } from "@/lib/utils";
import julpaketKort from "@/assets/julklapp/julpaket-kort.png";
import barnITradgarden from "@/assets/julklapp/barn-i-tradgarden.jpg";

/**
 * Ge ett julpaket: the Christmas campaign. A visitor gives a julpaket to the children in Addis Abeba
 * and the association sends a julkort in their name on Christmas morning. Repejo handles the
 * checkout and the progress bar (ADR 0003). The campaign's own facts come from
 * src/data/julkampanj.json (Pages CMS); every empty field shows the chip "fylls i".
 * Seasonal: after Christmas the page can be removed, or the short code changed (src/lib/repejo.ts),
 * without touching anything else.
 */
const { sistaDag, efterJulpaketen } = hamtaJulkampanj();

/** The page is built only when the flag `julklapp` is on (src/data/funktioner.json); otherwise /julklapp is a 404. */
export function getStaticPaths() {
  return hamtaFunktioner().julklapp ? [{ params: { julklapp: "julklapp" } }] : [];
}

const section = "py-[clamp(64px,9vw,120px)]";
const h2 = "text-headline";
const split = "grid grid-cols-1 gap-[clamp(32px,6vw,72px)] min-[901px]:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]";
---

<BaseLayout
  title="Ge ett julpaket"
  current="julklapp"
  description="Ge ett julpaket till ett barn i Addis Abeba och gläd samtidigt någon du tycker om. Vi skickar ditt julkort i ditt namn på julaftonsmorgonen."
>
  <Repejo slot="head" del="skript" />

  <div
    slot="header"
    class={`${split} items-start pt-[clamp(28px,5vw,56px)] pb-[clamp(56px,8vw,104px)] min-[901px]:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]`}
  >
    <div class="min-w-0">
      <h1 class="max-w-[14ch] text-[clamp(2.2rem,5.4vw,4.6rem)] leading-[0.98] tracking-[-0.035em]">
        Ge ett julpaket som sprider <span class="text-gold">hopp</span>
      </h1>
      <p class="mt-[22px] max-w-[40ch] text-lede text-mint">
        I jul får alla 20 fadderbarn i Addis Abeba ett julpaket med en julklapp till barnet och en gåva till familjen.
        Var med och ge ett, och gläd samtidigt någon du tycker om.
      </p>
      <p class="mt-3.5 max-w-[42ch]">
        Du väljer ett belopp och skriver ett julkort. Vi skickar kortet i ditt namn på julaftonsmorgonen.
      </p>
      <div class="mt-[30px] flex flex-wrap gap-3.5">
        <a class={buttonVariants()} href="#ge">Ge ett julpaket <Pil /></a>
        <a class={buttonVariants({ variant: "line" })} href="#sa-gar-det-till">Så går det till</a>
      </div>
    </div>

    <div class="min-w-0">
      <Image
        class="kort block w-full max-w-[560px] rounded-md shadow-[0_24px_48px_-12px_rgba(4,26,19,0.55)] min-[901px]:ml-auto"
        src={julpaketKort}
        alt="Julkort med texten ”God jul!”. Bredvid texten ett brunt paket med lapp där det står Addis Abeba, förseglat med rött vax. Nederst ”Ett julpaket i ditt namn” och Streetlights logotyp."
        widths={[480, 960, 1200]}
        sizes="(min-width: 592px) 560px, 100vw"
        loading="eager"
      />
    </div>
  </div>

  <LightBand utanText />

  <section aria-labelledby="tjugo-rubrik" class={`border-b border-rule bg-white text-ink ${section}`}>
    <div class={`band-inner ${split} items-center`}>
      <div class="min-w-0">
        <h2 id="tjugo-rubrik" class={h2}>20 barn, 20 julpaket</h2>
        <p class="mt-[22px] max-w-[52ch]">
          Vi är små med flit, så att stödet når fram och vi känner varje familj. I jul vill vi att alla 20 fadderbarn
          får ett julpaket.
        </p>
      </div>
      <div class="min-w-0">
        <section aria-label="Insamlingsmålet">
          <Repejo del="matare" />
        </section>
        <p class="mt-4 text-ink-soft">Ett julpaket kostar 400 kr. 20 julpaket blir 8 000 kr.</p>
      </div>
    </div>
  </section>

  <section id="sa-gar-det-till" aria-labelledby="steg-rubrik" class={`scroll-mt-4 bg-cotton text-ink ${section}`}>
    <div class="band-inner">
      <h2 id="steg-rubrik" class={`${h2} max-w-[22ch]`}>Tre steg till ett julkort som betyder något</h2>
      <Steps class="steg mt-[clamp(28px,4vw,40px)]" aria-labelledby="steg-rubrik">
        <li>
          <h3 class="stegrubrik">Välj ett belopp</h3>
          <p>Du bestämmer hur mycket du vill ge. Pengarna går till julpaketen för barnen och familjerna i Addis Abeba.</p>
        </li>
        <li>
          <h3 class="stegrubrik">Skriv ett julkort</h3>
          <p>Skriv en hälsning till den du vill glädja: en vän, en granne, mormor eller en kollega.</p>
        </li>
        <li>
          <h3 class="stegrubrik">Vi skickar det på julaftonsmorgonen</h3>
          <p>Julkortet kommer som ett sms i ditt namn när julen börjar. Du behöver inte göra något mer.</p>
        </li>
      </Steps>
    </div>
  </section>

  <section id="ge" aria-labelledby="ge-rubrik" class={`scroll-mt-4 border-b border-rule bg-white text-ink ${section}`}>
    <div class="band-inner">
      <div class="max-w-[52ch]">
        <h2 id="ge-rubrik" class={h2}>Ge ett julpaket</h2>
        <p class="mt-[22px]">Välj ett belopp, skriv ditt julkort och betala.</p>
      </div>
      <div class="mt-[clamp(28px,4vw,40px)] max-w-[720px]">
        <Repejo del="checkout" />
        <p class="mt-5 font-semibold">
          Beställ senast {sistaDag ?? <FyllsI>sista dag fylls i</FyllsI>}, så kommer ditt julkort fram på
          julaftonsmorgonen.
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby="vart-rubrik" class={`bg-cotton text-ink ${section}`}>
    <div class={`band-inner ${split} items-center`}>
      <div class="min-w-0">
        <h2 id="vart-rubrik" class={h2}>Vart julpaketen går</h2>
        <p class="mt-[22px] max-w-[52ch]">
          Streetlight stöttar 20 fadderbarns skolgång och deras familjer i Addis Abeba. Barnen väljs ut tillsammans med
          de lokala myndigheterna, och Streetlight Etiopien bär arbetet med barnen och familjerna på plats.
        </p>
        <div class="mt-6 max-w-[52ch] rounded-md border border-rule bg-white p-6">
          <h3 class="stegrubrik">Det här finns i julpaketet</h3>
          <p class="mt-2">
            I jul får alla 20 fadderbarn ett julpaket. I paketet finns en julklapp till barnet och en kontantgåva till
            familjen. Familjen bestämmer själv vad gåvan används till, till exempel julmat, kläder eller något som behövs
            hemma. Streetlight Etiopien känner varje familj och lämnar paketen personligen.
          </p>
        </div>
        <p class="mt-4 max-w-[52ch]">
          När alla 20 julpaket är klara går resten till {efterJulpaketen ?? <FyllsI>fylls i av föreningen</FyllsI>}.
        </p>
        <p class="mt-4 max-w-[52ch] text-ink-soft">
          Vill du göra mer än en gång?{" "}
          <a class="font-semibold text-ink underline" href={href("/bli-fadder")}>Läs om att bli fadder</a>.
        </p>
      </div>
      <Image
        class="block aspect-[4/3] w-full rounded-md object-cover"
        src={barnITradgarden}
        alt="Barn och ungdomar i en grönskande trädgård i Addis Abeba. Några i förgrunden tar en selfie och ler mot kameran, och en av dem visar tummen upp."
        widths={[440, 880, 1320]}
        sizes="(min-width: 901px) 560px, 100vw"
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* The julkort lies a little askew on wide screens, and straight on a phone. */
  .kort {
    transform: rotate(-2.5deg);
  }
  @media (max-width: 760px) {
    .kort {
      transform: none;
    }
  }
  .stegrubrik {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lede);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  ol.steg {
    gap: 24px;
  }
  .steg p {
    margin-top: 6px;
    max-width: 40ch;
    color: var(--color-ink-soft);
  }
</style>
