---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ExampleChip from "@/components/ExampleChip.astro";
import FyllsI from "@/components/FyllsI.astro";
import LightBand from "@/components/LightBand.astro";
import Pil from "@/components/Pil.astro";
import Placeholder from "@/components/Placeholder.astro";
import Repejo from "@/components/Repejo.astro";
import Steps from "@/components/Steps.astro";
import TibebBand from "@/components/TibebBand.astro";
import { hamtaFunktioner } from "@/lib/funktioner";
import TjugoLjus from "@/components/TjugoLjus.astro";
import { buttonVariants } from "@/components/ui/button";
import { hamtaForeningsuppgifter } from "@/lib/foreningsuppgifter";
import { hamtaJulkampanj } from "@/lib/julkampanj";
import { href } from "@/lib/utils";

/**
 * Ge en julklapp: the Christmas campaign. A visitor gives a julklapp to the children in Addis Abeba
 * and the association sends a julkort in their name on Christmas morning. Repejo handles the
 * checkout and the progress bar (ADR 0003). The campaign's own facts come from
 * src/data/julkampanj.json (Pages CMS); every empty field shows the chip "fylls i".
 * Seasonal: after Christmas the page can be removed, or the short code changed (src/lib/repejo.ts),
 * without touching anything else.
 */
const { vadJulklappenGor, epost: kampanjensEpost } = hamtaJulkampanj();
const epost = kampanjensEpost ?? hamtaForeningsuppgifter().epost;

/** The page is built only when the flag `julklapp` is on (src/data/funktioner.json); otherwise /julklapp is a 404. */
export function getStaticPaths() {
  return hamtaFunktioner().julklapp ? [{ params: { julklapp: "julklapp" } }] : [];
}

/** The wax seal's soft edge: a ring of overlapping drops around the disc. */
const SIGILL_KANT = Array.from({ length: 18 }, (_, i) => {
  const v = (i / 18) * Math.PI * 2;
  return { x: 50 + Math.cos(v) * 41, y: 50 + Math.sin(v) * 41, r: 7 + (i % 3) };
});

const section = "py-[clamp(64px,9vw,120px)]";
const h2 = "text-headline";
const split = "grid grid-cols-1 gap-[clamp(32px,6vw,72px)] min-[901px]:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]";
---

<BaseLayout
  title="Ge en julklapp"
  current="julklapp"
  description="Ge en julklapp till barnen i Addis Abeba och glädj samtidigt någon du tycker om. Vi skickar ditt julkort i ditt namn på julaftonsmorgonen."
>
  <Repejo slot="head" del="skript" />

  <div
    slot="header"
    class={`${split} items-center pt-[clamp(28px,5vw,56px)] pb-[clamp(56px,8vw,104px)] min-[901px]:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]`}
  >
    <div class="min-w-0">
      <h1 class="max-w-[14ch] text-[clamp(2.2rem,5.4vw,4.6rem)] leading-[0.98] tracking-[-0.035em]">
        Ge en julklapp som sprider <span class="text-gold">hopp</span>
      </h1>
      <p class="mt-[22px] max-w-[40ch] text-lede text-mint">
        Den här julen kan du ge en julklapp till barnen i Addis Abeba och samtidigt glädja någon du tycker om.
      </p>
      <p class="mt-3.5 max-w-[42ch]">
        Du väljer ett belopp, skriver ett julkort och vi skickar det i ditt namn på julaftonsmorgonen.
      </p>
      <div class="mt-[30px] flex flex-wrap gap-3.5">
        <a class={buttonVariants()} href="#ge">Ge en julklapp <Pil /></a>
      </div>
    </div>

    <div class="kort-plats min-w-0">
      <svg class="sken" viewBox="0 0 300 300" aria-hidden="true"
        ><path d="M110 0H190L300 300H0Z" fill="#F4B400" opacity="0.18"></path><path
          d="M110 0H190L262 200H38Z"
          fill="#FFCF45"
          opacity="0.2"></path><path d="M110 0H190L226 100H74Z" fill="#FFDB73" opacity="0.22"></path></svg
      >
      <figure class="julklapp">
        <!-- The parcel: cotton paper with a woven tibeb ribbon, a red thread bow and a tag. -->
        <svg class="paket" viewBox="0 0 420 290" aria-hidden="true">
          <defs>
            <pattern id="papper" width="22" height="22" patternUnits="userSpaceOnUse">
              <path d="M11 6l3 3-3 3-3-3z" fill="#F4B400" opacity="0.5"></path>
            </pattern>
          </defs>
          <ellipse cx="215" cy="262" rx="170" ry="22" fill="#041A13" opacity="0.35"></ellipse>
          <path d="M60 92 170 152V262L60 202Z" fill="#E6E9DF"></path>
          <path d="M170 152 360 97V207L170 262Z" fill="#D3D9CC"></path>
          <path d="M60 92 250 40 360 97 170 152Z" fill="#FBFBF8"></path>
          <path d="M60 92 170 152V262L60 202Z M170 152 360 97V207L170 262Z M60 92 250 40 360 97 170 152Z" fill="url(#papper)"></path>
          <g fill="none" stroke-linecap="butt">
            <path d="M155 66 265 124.5V234.5 M115 122 305 68.5" stroke="#D64527" stroke-width="20"></path>
            <path d="M155 66 265 124.5V234.5 M115 122 305 68.5" stroke="#0E4A38" stroke-width="15"></path>
            <path d="M155 66 265 124.5V234.5 M115 122 305 68.5" stroke="#F4B400" stroke-width="6" stroke-dasharray="5 7"></path>
            <path d="M115 122V232" stroke="#D64527" stroke-width="20"></path>
            <path d="M115 122V232" stroke="#0E4A38" stroke-width="15"></path>
            <path d="M115 122V232" stroke="#F4B400" stroke-width="6" stroke-dasharray="5 7"></path>
          </g>
          <g fill="none" stroke="#D64527" stroke-width="5" stroke-linecap="round">
            <path d="M210 95c-30-34-74-28-62-4 10 18 44 10 62 4Z"></path>
            <path d="M210 95c28-36 76-34 66-8-9 20-44 14-66 8Z"></path>
            <path d="M210 95c-14 18-30 34-40 52 M210 95c10 20 18 38 34 50"></path>
          </g>
          <circle cx="210" cy="95" r="7" fill="#D64527"></circle>
          <path d="M210 95 268 150" stroke="#FBFBF8" stroke-width="1.5"></path>
          <g transform="rotate(22 300 168)">
            <path d="M262 150h86v40h-86l-12-20Z" fill="#FFDB73"></path>
            <circle cx="262" cy="170" r="3.5" fill="#D3D9CC"></circle>
            <text x="306" y="166" text-anchor="middle" fill="#0B2E24" font-family="var(--font-display)" font-weight="700" font-size="14">Till Maja</text>
            <text x="306" y="182" text-anchor="middle" fill="#3D5E53" font-family="var(--font-body)" font-size="10">God jul</text>
          </g>
        </svg>

        <!-- The julkort, open: the lamp's light on the left, the greeting on the right, the seal on the fold. -->
        <div class="kort">
          <div class="kort-bild">
            <svg viewBox="0 0 200 150" aria-hidden="true">
              <path d="M20 132h160" stroke="#0B2E24" stroke-width="2" stroke-linecap="round"></path>
              <path d="M24 138h152" stroke="#D64527" stroke-width="2" stroke-dasharray="6 5"></path>
              <path d="M98 34h8L130 128H54Z" fill="#FFDB73"></path>
              <path d="M98 34h8L120 90H74Z" fill="#FFCF45"></path>
              <path d="M98 34h8L112 60H84Z" fill="#F4B400"></path>
              <path d="M150 132V48a26 26 0 0 0-26-26H98" fill="none" stroke="#0B2E24" stroke-width="4"></path>
              <path d="M96 30h12v5H96Z" fill="#0B2E24"></path>
              <g fill="#F4B400">
                <path d="M34 26l4 4-4 4-4-4z"></path><path d="M60 12l3 3-3 3-3-3z"></path><path d="M172 18l4 4-4 4-4-4z"></path>
                <path d="M44 62l3 3-3 3-3-3z"></path><path d="M178 72l3 3-3 3-3-3z"></path>
              </g>
            </svg>
            <p class="kort-halsning">God jul och gott nytt år</p>
          </div>
          <div class="kort-text">
            <p class="font-display text-[clamp(1.6rem,2.6vw,2rem)] leading-none font-extrabold tracking-[-0.03em]">
              God jul, Maja!
            </p>
            <p>I år har jag gett en julklapp i ditt namn till barnen i Addis Abeba. Ett litet ljus till, mitt i vintern.</p>
            <p class="text-ink-soft">Kram, Anna</p>
          </div>
          <svg class="sigill" viewBox="0 0 100 100" aria-hidden="true">
            <defs><path id="sigill-text" d="M50 50m-31 0a31 31 0 1 1 62 0a31 31 0 1 1-62 0"></path></defs>
            {SIGILL_KANT.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill="#C23A1F" />)}
            <circle cx="50" cy="50" r="42" fill="#D64527"></circle>
            <circle cx="50" cy="50" r="38" fill="none" stroke="#A8301A" stroke-width="1.5"></circle>
            <circle cx="50" cy="50" r="24" fill="none" stroke="#A8301A" stroke-width="1.5"></circle>
            <text fill="#FBE0D8" font-family="var(--font-display)" font-weight="700" font-size="10" >
              <textPath href="#sigill-text" textLength="192" lengthAdjust="spacing">STREETLIGHT · GOD JUL ·</textPath>
            </text>
            <path d="M58 64V44a8 8 0 0 0-8-8h-8" fill="none" stroke="#A8301A" stroke-width="3"></path>
            <path d="M40 38h4l6 24H34Z" fill="#A8301A"></path>
          </svg>
        </div>
        <figcaption class="exempel flex flex-wrap items-center gap-2.5 font-semibold">
          <ExampleChip />
          <span>Exempel på ett julkort. Du skriver din egen hälsning.</span>
        </figcaption>
      </figure>
    </div>
  </div>

  <section aria-labelledby="mal-rubrik" class="on-green">
    <LightBand>
      <div class="band-inner mal">
        <h2 id="mal-rubrik" class={`mal-rubrik ${h2}`}>Håll ljusen <span class="text-gold">tända</span> i jul</h2>
        <p class="mal-ingress text-mint"><TjugoLjus /></p>
        <p class="mal-etikett text-mint">Så långt har vi kommit mot insamlingsmålet</p>
        <div class="mal-matare"><Repejo del="matare" /></div>
      </div>
    </LightBand>
  </section>

  <TibebBand />

  <!-- The three steps and the checkout in one section: the steps tell what happens, Repejo does it. -->
  <section id="ge" aria-labelledby="ge-rubrik" class={`scroll-mt-4 border-b border-rule bg-white text-ink ${section}`}>
    <div class={`band-inner ${split} items-start min-[901px]:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]`}>
      <div class="min-w-0">
        <h2 id="ge-rubrik" class={h2}>Ge en julklapp</h2>
        <Steps class="steg mt-[clamp(28px,4vw,40px)]" aria-labelledby="ge-rubrik">
          <li>
            <h3 class="stegrubrik">Välj ett belopp</h3>
            <p>Du bestämmer själv hur stor julklappen blir. Den går till barnen och familjerna i Addis Abeba.</p>
          </li>
          <li>
            <h3 class="stegrubrik">Skriv ett julkort</h3>
            <p>Skriv en hälsning till den du vill glädja: en vän, en granne, mormor eller en kollega.</p>
          </li>
          <li>
            <h3 class="stegrubrik">Vi skickar det på julaftonsmorgonen</h3>
            <p>Julkortet kommer fram i ditt namn när julen börjar. Du behöver inte göra något mer.</p>
          </li>
        </Steps>
        <ul class="mt-8 grid list-disc gap-3 border-t border-rule pt-6 pl-[1.1em] text-ink-soft">
          <li>
            Repejo sköter betalningen. Repejo är föreningens insamlingstjänst, och det du fyller i där går till Repejo.
          </li>
          <li>
            Frågor? Mejla{" "}
            {
              epost ? (
                <a class="font-semibold text-ink underline" href={`mailto:${epost}`}>
                  {epost}
                </a>
              ) : (
                <FyllsI>e-post fylls i</FyllsI>
              )
            }
          </li>
        </ul>
      </div>
      <Repejo del="checkout" />
    </div>
  </section>

  <section aria-labelledby="vart-rubrik" class={`bg-cotton text-ink ${section}`}>
    <div class={`band-inner ${split} items-center`}>
      <div class="min-w-0">
        <h2 id="vart-rubrik" class={h2}>Vart julklappen går</h2>
        <p class="mt-[22px] max-w-[52ch]">
          Streetlight stöttar 20 fadderbarns skolgång och deras familjer i Addis Abeba. Barnen väljs ut tillsammans med
          de lokala myndigheterna, och Streetlight Etiopien bär arbetet med barnen och familjerna på plats.
        </p>
        <p class="mt-4 max-w-[52ch]">
          Det här gör din julklapp: {vadJulklappenGor ?? <FyllsI>fylls i av föreningen</FyllsI>}
        </p>
        <p class="mt-4 max-w-[52ch] text-ink-soft">
          Vill du göra mer än en gång?{" "}
          <a class="font-semibold text-ink underline" href={href("/bli-fadder")}>Läs om att bli fadder</a>.
        </p>
      </div>
      <Placeholder class="aspect-[4/3]" text="Foto från föreningen, med familjens samtycke" />
    </div>
  </section>
</BaseLayout>

<style>
  /* The goal: the lede and the label share one text line; the meter hangs under the label. */
  .mal {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "rubrik" "ingress" "etikett" "matare";
    gap: 14px clamp(32px, 5vw, 56px);
    padding-block: clamp(40px, 5vw, 56px);
  }
  .mal > * {
    min-width: 0;
    margin: 0;
  }
  .mal-rubrik {
    grid-area: rubrik;
  }
  .mal-ingress {
    grid-area: ingress;
    max-width: 46ch;
  }
  .mal-etikett {
    grid-area: etikett;
    font-weight: 600;
  }
  .mal-matare {
    grid-area: matare;
  }
  @media (min-width: 901px) {
    .mal {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-areas: "rubrik ." "ingress etikett" ". matare";
    }
    .mal-ingress,
    .mal-etikett {
      align-self: baseline;
    }
    .mal-matare {
      margin-top: 6px;
    }
  }
  /* The example julkort, tilted a little on wide screens, with the lamp's light falling on it. */
  .kort-plats {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .sken {
    position: absolute;
    top: -40px;
    right: -10px;
    width: 300px;
    height: 300px;
    pointer-events: none;
  }
  .julklapp {
    position: relative;
    width: 100%;
    max-width: 480px;
    margin: 0;
  }
  .paket {
    display: block;
    width: 88%;
    margin-inline: auto;
    transform: rotate(3deg);
  }
  /* The open julkort lies over the front of the parcel. */
  .kort {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    margin-top: -15%;
    border-radius: var(--radius-md);
    background:
      linear-gradient(90deg, transparent 42.2%, rgba(11, 46, 36, 0.14) 42.5%, transparent 43.4%),
      linear-gradient(90deg, #f1f3ec 0%, var(--color-cotton) 42.5%, var(--color-cotton) 100%);
    color: var(--color-ink);
    box-shadow:
      0 24px 48px -12px rgba(4, 26, 19, 0.55),
      0 4px 10px rgba(4, 26, 19, 0.25);
    transform: rotate(-2.5deg);
  }
  .kort-bild {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
    padding: clamp(18px, 2.4vw, 26px) clamp(14px, 2vw, 22px);
  }
  .kort-bild svg {
    width: 100%;
    height: auto;
  }
  .kort-halsning {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lede);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .kort-text {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: clamp(18px, 2.4vw, 26px) clamp(18px, 2.4vw, 28px) 76px;
  }
  /* The wax seal sits on the fold, over the card's lower edge. */
  .sigill {
    position: absolute;
    left: 42.5%;
    bottom: -34px;
    width: 104px;
    height: 104px;
    transform: translateX(-50%) rotate(-8deg);
    filter: drop-shadow(0 4px 6px rgba(4, 26, 19, 0.35));
  }
  .exempel {
    margin-top: 52px;
    color: var(--color-mint);
  }
  @media (max-width: 760px) {
    .kort,
    .paket {
      transform: none;
    }
    .sken {
      display: none;
    }
  }
  /* On a phone the card is folded the other way: the lamp above, the greeting below, the seal on the fold. */
  @media (max-width: 520px) {
    .kort {
      grid-template-columns: minmax(0, 1fr);
      background:
        linear-gradient(180deg, #f1f3ec 0%, var(--color-cotton) 100%);
    }
    .kort-bild {
      flex-direction: row;
      align-items: center;
      border-bottom: 1px solid rgba(11, 46, 36, 0.14);
    }
    .kort-bild svg {
      width: 44%;
      flex: none;
    }
    .kort-text {
      padding-bottom: clamp(18px, 2.4vw, 26px);
    }
    .sigill {
      left: auto;
      right: 12px;
      bottom: -30px;
      width: 88px;
      height: 88px;
      transform: rotate(-8deg);
    }
  }
  .stegrubrik {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lede);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  ol.steg {
    gap: 24px;
  }
  .steg p {
    margin-top: 6px;
    max-width: 40ch;
    color: var(--color-ink-soft);
  }
</style>
