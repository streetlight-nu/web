---
import markOnLight from "@/assets/logo/streetlight-mark-pa-ljust.svg?raw";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ExampleChip from "@/components/ExampleChip.astro";
import FyllsI from "@/components/FyllsI.astro";
import LightBand from "@/components/LightBand.astro";
import Placeholder from "@/components/Placeholder.astro";
import Repejo from "@/components/Repejo.astro";
import Steps from "@/components/Steps.astro";
import TibebBand from "@/components/TibebBand.astro";
import { hamtaFunktioner } from "@/lib/funktioner";
import TjugoLjus from "@/components/TjugoLjus.astro";
import { buttonVariants } from "@/components/ui/button";
import { hamtaForeningsuppgifter } from "@/lib/foreningsuppgifter";
import { hamtaJulkampanj } from "@/lib/julkampanj";
import { href } from "@/lib/utils";

/**
 * Ge en julklapp: the Christmas campaign. A visitor gives a julklapp to the children in Addis Abeba
 * and the association sends a julkort in their name on Christmas morning. Repejo handles the
 * checkout and the progress bar (ADR 0003). The campaign's own facts come from
 * src/data/julkampanj.json (Pages CMS); every empty field shows the chip "fylls i".
 * Seasonal: after Christmas the page can be removed, or the short code changed (src/lib/repejo.ts),
 * without touching anything else.
 */
const { sistaDag, vadJulklappenGor, epost: kampanjensEpost } = hamtaJulkampanj();
const epost = kampanjensEpost ?? hamtaForeningsuppgifter().epost;

/** The page is built only when the flag `julklapp` is on (src/data/funktioner.json); otherwise /julklapp is a 404. */
export function getStaticPaths() {
  return hamtaFunktioner().julklapp ? [{ params: { julklapp: "julklapp" } }] : [];
}

const mark = markOnLight
  .replace(/ width="\d+" height="\d+"/, "")
  .replace("<svg ", '<svg aria-hidden="true" focusable="false" class="size-16 flex-none" ');

const section = "py-[clamp(64px,9vw,120px)]";
const h2 = "text-headline";
const split = "grid grid-cols-1 gap-[clamp(32px,6vw,72px)] min-[901px]:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]";
const arrow = `<svg viewBox="0 0 18 18" aria-hidden="true"><path d="M3 9h11M10 4.5 14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;
---

<BaseLayout
  title="Ge en julklapp"
  current="julklapp"
  description="Ge en julklapp till barnen i Addis Abeba och glädj samtidigt någon du tycker om. Vi skickar ditt julkort i ditt namn på julaftonsmorgonen."
>
  <Repejo slot="head" del="skript" />

  <div
    slot="header"
    class={`${split} items-center pt-[clamp(28px,5vw,56px)] pb-[clamp(56px,8vw,104px)] min-[901px]:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]`}
  >
    <div class="min-w-0">
      <h1 class="max-w-[14ch] text-[clamp(2.2rem,5.4vw,4.6rem)] leading-[0.98] tracking-[-0.035em]">
        Ge en julklapp som sprider <span class="text-gold">hopp</span>
      </h1>
      <p class="mt-[22px] max-w-[40ch] text-lede text-mint">
        Den här julen kan du ge en julklapp till barnen i Addis Abeba och samtidigt glädja någon du tycker om.
      </p>
      <p class="mt-3.5 max-w-[42ch]">
        Du väljer ett belopp, skriver ett julkort och vi skickar det i ditt namn på julaftonsmorgonen.
      </p>
      <div class="mt-[30px] flex flex-wrap gap-3.5">
        <a class={buttonVariants()} href="#ge">Ge en julklapp <Fragment set:html={arrow} /></a>
        <a class={buttonVariants({ variant: "line" })} href="#sa-gar-det-till">Så går det till</a>
      </div>
      <p class="mt-6 text-mint">
        Sista dagen att ge en julklapp med kort:{" "}
        {sistaDag ? <strong class="font-semibold text-cotton">{sistaDag}</strong> : <FyllsI>datum fylls i</FyllsI>}
      </p>
    </div>

    <div class="kort-plats min-w-0">
      <svg class="sken" viewBox="0 0 300 300" aria-hidden="true"
        ><path d="M110 0H190L300 300H0Z" fill="#F4B400" opacity="0.18"></path><path
          d="M110 0H190L262 200H38Z"
          fill="#FFCF45"
          opacity="0.2"></path><path d="M110 0H190L226 100H74Z" fill="#FFDB73" opacity="0.22"></path></svg
      >
      <figure class="kort">
        <TibebBand variant="thin" />
        <div class="grid gap-[18px] p-[clamp(22px,3vw,32px)]">
          <div class="flex items-start justify-between gap-4">
            <p class="font-display text-[clamp(2rem,3.4vw,2.5rem)] leading-none font-extrabold tracking-[-0.03em]">
              God jul,<br />Maja!
            </p>
            <Fragment set:html={mark} />
          </div>
          <p>I år har jag gett en julklapp i ditt namn till barnen i Addis Abeba. Ett litet ljus till, mitt i vintern.</p>
          <p class="text-ink-soft">Kram, Anna</p>
          <div class="flex flex-wrap items-baseline gap-3 border-t border-rule pt-3.5">
            <span lang="am" class="text-[1.9rem] leading-none">ብርሃን</span>
            <span class="text-label text-ink-soft">”ljus” på amhariska, uttalas birhan</span>
          </div>
        </div>
        <figcaption class="flex flex-wrap items-center gap-2.5 bg-mint px-[clamp(22px,3vw,32px)] py-2.5 font-semibold">
          <ExampleChip />
          <span>Exempel på ett julkort. Du skriver din egen hälsning.</span>
        </figcaption>
      </figure>
    </div>
  </div>

  <section aria-labelledby="mal-rubrik" class="on-green">
    <LightBand>
      <div
        class="band-inner grid grid-cols-1 items-end gap-x-[clamp(32px,5vw,56px)] gap-y-8 py-[clamp(40px,5vw,56px)] min-[901px]:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]"
      >
        <div class="min-w-0">
          <h2 id="mal-rubrik" class={h2}>Håll ljusen <span class="text-gold">tända</span> i jul</h2>
          <p class="mt-3.5 max-w-[46ch] text-mint"><TjugoLjus /></p>
        </div>
        <div class="min-w-0">
          <p class="mb-2.5 font-semibold text-mint">Så långt har vi kommit mot insamlingsmålet</p>
          <Repejo del="matare" />
        </div>
      </div>
    </LightBand>
  </section>

  <TibebBand />

  <section id="sa-gar-det-till" aria-labelledby="steg-rubrik" class={`bg-cotton text-ink ${section}`}>
    <div class="band-inner">
      <h2 id="steg-rubrik" class={`max-w-[16ch] ${h2}`}>Tre steg till ett julkort som betyder något</h2>
      <Steps class="steg mt-[clamp(32px,5vw,56px)]" aria-labelledby="steg-rubrik">
        <li>
          <h3 class="stegrubrik">Välj ett belopp</h3>
          <p>Du bestämmer själv hur stor julklappen blir. Den går till barnen och familjerna i Addis Abeba.</p>
        </li>
        <li>
          <h3 class="stegrubrik">Skriv ett julkort</h3>
          <p>Skriv en hälsning till den du vill glädja: en vän, en granne, mormor eller en kollega.</p>
        </li>
        <li>
          <h3 class="stegrubrik">Vi skickar det på julaftonsmorgonen</h3>
          <p>Julkortet kommer fram i ditt namn när julen börjar. Du behöver inte göra något mer.</p>
        </li>
      </Steps>
    </div>
  </section>

  <section id="ge" aria-labelledby="ge-rubrik" class={`scroll-mt-4 border-y border-rule bg-white text-ink ${section}`}>
    <div class={`band-inner ${split} items-start min-[901px]:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]`}>
      <div class="min-w-0">
        <h2 id="ge-rubrik" class={h2}>Ge en julklapp</h2>
        <p class="mt-[22px] max-w-[40ch] text-lede">Välj ett belopp, skriv ditt julkort och betala.</p>
        <ul class="mt-6 grid list-disc gap-3 pl-[1.1em] text-ink-soft">
          <li>
            Repejo sköter betalningen. Repejo är föreningens insamlingstjänst, och det du fyller i där går till Repejo.
          </li>
          <li>
            Frågor? Mejla{" "}
            {
              epost ? (
                <a class="font-semibold text-ink underline" href={`mailto:${epost}`}>
                  {epost}
                </a>
              ) : (
                <FyllsI>e-post fylls i</FyllsI>
              )
            }
          </li>
        </ul>
      </div>
      <Repejo del="checkout" />
    </div>
  </section>

  <section aria-labelledby="vart-rubrik" class={`bg-cotton text-ink ${section}`}>
    <div class={`band-inner ${split} items-center`}>
      <div class="min-w-0">
        <h2 id="vart-rubrik" class={h2}>Vart julklappen går</h2>
        <p class="mt-[22px] max-w-[52ch]">
          Streetlight stöttar 20 fadderbarns skolgång och deras familjer i Addis Abeba. Barnen väljs ut tillsammans med
          de lokala myndigheterna, och Streetlight Etiopien bär arbetet med barnen och familjerna på plats.
        </p>
        <p class="mt-4 max-w-[52ch]">
          Det här gör din julklapp: {vadJulklappenGor ?? <FyllsI>fylls i av föreningen</FyllsI>}
        </p>
        <p class="mt-4 max-w-[52ch] text-ink-soft">
          Vill du göra mer än en gång?{" "}
          <a class="font-semibold text-ink underline" href={href("/stod-oss")}>Läs om att bli fadder</a>.
        </p>
      </div>
      <Placeholder class="aspect-[4/3]" text="Foto från föreningen, med familjens samtycke" />
    </div>
  </section>

  <section aria-labelledby="slut-rubrik" class={`on-green bg-green text-cotton ${section}`}>
    <div class="band-inner flex flex-wrap items-center justify-between gap-8">
      <h2
        id="slut-rubrik"
        class="max-w-[20ch] min-w-0 flex-[1_1_480px] font-display text-[clamp(2.2rem,5.4vw,4.6rem)] leading-[1.02] tracking-[-0.03em]"
      >
        En julklapp till barnen. Ett <span class="text-gold">ljus</span> till någon du tycker om.
      </h2>
      <a class={buttonVariants()} href="#ge">Ge en julklapp <Fragment set:html={arrow} /></a>
    </div>
  </section>
</BaseLayout>

<style>
  /* The example julkort, tilted a little on wide screens, with the lamp's light falling on it. */
  .kort-plats {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .sken {
    position: absolute;
    top: -40px;
    right: -10px;
    width: 300px;
    height: 300px;
    pointer-events: none;
  }
  .kort {
    position: relative;
    width: 100%;
    max-width: 420px;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-cotton);
    color: var(--color-ink);
    box-shadow:
      0 24px 48px -12px rgba(4, 26, 19, 0.55),
      0 4px 10px rgba(4, 26, 19, 0.25);
    transform: rotate(-2.5deg);
  }
  @media (max-width: 760px) {
    .kort {
      transform: none;
    }
    .sken {
      display: none;
    }
  }
  .stegrubrik {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.4rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  /* The three steps side by side on wide screens. */
  ol.steg {
    gap: 32px;
  }
  .steg p {
    margin-top: 10px;
    max-width: 34ch;
    color: var(--color-ink-soft);
  }
  @media (min-width: 901px) {
    .steg {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
