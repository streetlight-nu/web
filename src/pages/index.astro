---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BliFadder from "@/components/BliFadder.astro";
import JulkampanjPaStartsidan from "@/components/JulkampanjPaStartsidan.astro";
import LightBand from "@/components/LightBand.astro";
import Pil from "@/components/Pil.astro";
import SenasteNytt from "@/components/SenasteNytt.astro";
import TibebBand from "@/components/TibebBand.astro";
import { buttonVariants } from "@/components/ui/button";
import { hamtaOmForeningen, stycken } from "@/lib/om-foreningen";
import { href } from "@/lib/utils";

/**
 * The start page tells why and who; the proof (what the support pays for, how the money reaches the children)
 * has its one home on the page Bli fadder, and the whole story on Om Streetlight. Så började det and the vision come from
 * src/data/om-foreningen.json, the same texts Om Streetlight shows.
 */
const om = hamtaOmForeningen();
const borjan = stycken(om.borjan)[0];
const NYCKELORD = "ljus framtid";
const [visionFore, visionEfter] = om.vision?.includes(NYCKELORD) ? om.vision.split(NYCKELORD, 2) : [om.vision, undefined];

const section = "py-[clamp(64px,9vw,120px)]";
const field = `on-green bg-green text-cotton ${section}`;
const split = "grid grid-cols-1 items-start gap-[clamp(32px,6vw,96px)] min-[901px]:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]";
const h2 = "text-headline";
const lede = "max-w-[58ch] text-lede";
const lankInk = "inline-flex min-h-11 items-center font-semibold underline decoration-gold decoration-2 underline-offset-[0.22em]";
const lankGron = "inline-flex min-h-11 items-center font-semibold text-cotton underline decoration-gold decoration-2 underline-offset-4";
---

<BaseLayout
  title="Streetlight"
  current="start"
  description="Streetlight är en ideell förening i Sverige och Etiopien som stöttar 20 fadderbarns skolgång och deras familjer i Addis Abeba."
>
  <!-- Motion is an addition: without JS or with reduced motion the lamp is simply lit. -->
  <script is:inline slot="head">
    try {
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("dusk");
    } catch (e) {}
  </script>
  <div
    slot="header"
    class="grid grid-cols-1 items-end gap-8 pt-[clamp(28px,5vw,64px)] min-[901px]:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)]"
  >
    <div class="min-w-0">
      <h1 class="max-w-[14ch] text-display tracking-[-0.035em]">
        Ett ljus på vägen <span class="text-gold">till skolan.</span>
      </h1>
      <p class="mt-[26px] max-w-[58ch] text-lede text-mint">
        Streetlight stöttar 20 fadderbarn från mycket fattiga familjer i Addis Abeba. Vi betalar skolgången och hjälper
        deras föräldrar att bygga en egen inkomst.
      </p>
      <div class="mt-[34px] flex flex-wrap gap-3.5 pb-3 max-[520px]:mt-[26px] min-[901px]:pb-[clamp(40px,6vw,76px)]">
        <a class={buttonVariants()} href={href("/bli-fadder")} data-huvudknapp>
          Bli fadder
          <Pil />
        </a>
        <a class={buttonVariants({ variant: "line" })} href={href("/bli-fadder#vart")}>Vad stödet går till</a>
      </div>
    </div>
    <div class="lamp-wrap">
      <div class="lamp" aria-hidden="true">
        <svg viewBox="0 0 180 560" preserveAspectRatio="xMaxYMax meet"
          ><g class="cone"
            ><path d="M40 36H56L100 560H-130Z" fill="#F4B400"></path><path
              d="M40 36H56L85.33 385H-73.33Z"
              fill="#FFCF45"></path><path d="M40 36H56L70.67 210H-16.67Z" fill="#FFDB73"></path></g
          ><path d="M150 560V100a70 70 0 0 0 -70 -70H40" fill="none" stroke="#FBFBF8" stroke-width="12"></path></svg
        >
      </div>
      <p class="amharic">
        <span lang="am" class="block text-[clamp(2.2rem,4vw,3.2rem)] leading-none text-gold">ብርሃን</span>
        <span class="mt-2 block max-w-[15ch] text-label font-medium tracking-[0.01em] text-mint"
          >”ljus” på amhariska, uttalas birhan</span
        >
      </p>
    </div>
  </div>

  <LightBand slot="header-after" />

  <JulkampanjPaStartsidan />

  <!-- What the support is for, then Så började det: one cotton field. -->
  <div class={`bg-cotton text-ink ${section}`}>
    <section id="stod" aria-labelledby="stod-rubrik" class:list={["band-inner", split]}>
      <h2 id="stod-rubrik" class={`min-w-0 ${h2}`}>Utbildning är vägen ut ur fattigdom.</h2>
      <div class="min-w-0">
        <p class={lede}>
          Därför står vi för det som annars stänger skolans dörr för ett barn i en fattig familj. Hela vägen, år för år.
        </p>
        <p class="mt-4">
          <a class={lankInk} href={href("/bli-fadder#vart")}>Se vart ditt bidrag går</a>
        </p>
      </div>
    </section>
    {
      borjan && (
        <section id="borjan" aria-labelledby="borjan-rubrik" class="band-inner mt-[clamp(56px,7vw,96px)]">
          <div class={`border-t-[3px] border-ink pt-[clamp(40px,5vw,64px)] ${split}`}>
            <h2 id="borjan-rubrik" class={`min-w-0 ${h2}`}>Så började det.</h2>
            <div class="min-w-0">
              <p class={lede}>{borjan}</p>
              <p class="mt-4">
                <a class={lankInk} href={href("/om-foreningen#borjan")}>Läs hela berättelsen om Streetlight</a>
              </p>
            </div>
          </div>
        </section>
      )
    }
  </div>

  <TibebBand variant="thin" />

  <section id="familjer" class={field}>
    <div class="band-inner">
      <h2 class={h2}>Ljuset ska nå hela <span class="text-gold">familjen.</span></h2>
      <p class={`mt-[22px] text-mint ${lede}`}>
        Ett barn som går i skolan behöver ett hem som klarar sig. Därför kan föräldrarna få stöd och ekonomisk hjälp
        att starta en egen verksamhet. Då får familjen en egen inkomst, och barnet kan fortsätta gå i skolan.
      </p>
    </div>
  </section>

  {
    om.vision && (
      <section class="vision bg-cotton py-[clamp(72px,10vw,140px)] text-ink">
        <figure class="band-inner">
          <blockquote class="max-w-[17ch] font-display text-[clamp(2.2rem,5.4vw,4.6rem)] leading-[1.02] font-extrabold tracking-[-0.03em] text-balance">
            {visionEfter !== undefined ? (
              <>
                {visionFore}
                <span class="highlight">{NYCKELORD}</span>
                {visionEfter}
              </>
            ) : (
              om.vision
            )}
          </blockquote>
          <figcaption class="mt-7 font-medium text-ink-soft">Streetlights vision</figcaption>
        </figure>
      </section>
    )
  }

  <TibebBand />

  <section id="sa-arbetar-vi" class={field}>
    <div class="band-inner">
      <div class="max-w-[760px]">
        <h2 class={h2}>Två föreningar. Två styrelser. Ett arbete.</h2>
        <p class={`mt-[22px] text-mint ${lede}`}>
          Streetlight är två fristående ideella föreningar, en i Sverige och en i Etiopien.
        </p>
      </div>
      <div class="orgs mt-14 grid grid-cols-1 items-stretch min-[901px]:grid-cols-[minmax(0,1fr)_120px_minmax(0,1fr)]">
        <article class="org">
          <h3 class="text-title tracking-[-0.015em]">Streetlight Sverige</h3>
          <p>Samlar in pengar från faddrar och stöttar arbetet i Etiopien ekonomiskt.</p>
          <ul><li>Tar emot fadderskap och gåvor</li><li>Har egen styrelse i Sverige</li></ul>
        </article>
        <div class="link" aria-hidden="true">
          <svg viewBox="0 0 120 40" preserveAspectRatio="none"
            ><path d="M0 20h120" stroke="#F4B400" stroke-width="3" stroke-dasharray="12 7"></path><path
              class="runner"
              d="M60 8 72 20 60 32 48 20Z"
              fill="#F4B400"></path></svg
          >
          <span>Ekonomiskt stöd</span>
        </div>
        <article class="org">
          <h3 class="text-title tracking-[-0.015em]">Streetlight Etiopien</h3>
          <p>Bär arbetet med barnen och familjerna på plats i Addis Abeba.</p>
          <ul><li>Känner varje familj</li><li>Har egen styrelse i Etiopien</li></ul>
        </article>
      </div>
      <p class="mt-14 border-t-[1.5px] border-mint/30 pt-6 text-mint">
        <a class={lankGron} href={href("/bli-fadder#nar-fram")}>Läs hur barnen väljs ut och hur pengarna når fram</a>
      </p>
    </div>
  </section>

  <SenasteNytt />

  <BliFadder />
</BaseLayout>

<script>
  // Vision: the gold light sweeps across "ljus framtid" the first time it is read.
  const highlight = document.querySelector<HTMLElement>(".vision .highlight");
  if (
    highlight &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches &&
    "IntersectionObserver" in window &&
    highlight.getBoundingClientRect().top > window.innerHeight
  ) {
    highlight.classList.add("unlit");
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        setTimeout(() => highlight.classList.remove("unlit"), 200);
      },
      { threshold: 0.7 },
    );
    io.observe(highlight.closest("blockquote") ?? highlight);
  }

  // Så arbetar vi: the diamond on "Ekonomiskt stöd" shows the direction of support once, when the
  // arrow is in view. Without the class `flow` it simply rests in the middle of the arrow.
  const support = document.querySelector<HTMLElement>("#sa-arbetar-vi .link");
  if (support && !matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        support.classList.add("flow");
      },
      { threshold: 0.8 },
    );
    io.observe(support);
  }
</script>

<style>
  /* The street lamp in the hero; its light falls to the woven band below. */
  .lamp-wrap {
    position: relative;
    align-self: stretch;
    min-height: 440px;
  }
  .lamp {
    position: absolute;
    right: 12%;
    bottom: 0;
    width: 180px;
    height: 100%;
    max-height: 560px;
  }
  .lamp svg {
    position: absolute;
    inset: auto 0 0 auto;
    height: 100%;
    width: auto;
    overflow: visible;
  }
  /* Dusk: the lamp flickers on, then its light falls onto the woven band. */
  @keyframes cone-on {
    0% {
      opacity: 0;
      transform: scaleY(0.02);
    }
    12% {
      opacity: 0.9;
      transform: scaleY(0.02);
    }
    20% {
      opacity: 0.15;
    }
    30% {
      opacity: 0.9;
    }
    100% {
      opacity: 1;
      transform: scaleY(1);
    }
  }
  .cone {
    transform-box: fill-box;
    transform-origin: 50% 0;
  }
  :global(.dusk) .cone {
    animation: cone-on 1.5s var(--ease-light) 0.4s both;
  }
  .amharic {
    position: absolute;
    left: 0;
    top: 12px;
    line-height: 1;
  }
  @media (max-width: 900px) {
    .lamp-wrap {
      min-height: 300px;
    }
    .lamp {
      right: 6%;
    }
  }
  @media (max-width: 520px) {
    .lamp-wrap {
      min-height: 190px;
    }
    .lamp svg {
      height: 190px;
    }
  }
  .highlight {
    background-image: linear-gradient(
      transparent 62%,
      var(--color-gold-soft) 62%,
      var(--color-gold-soft) 92%,
      transparent 92%
    );
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transition: background-size 0.9s var(--ease-light);
  }
  /* Set only by the script, so the highlight is lit without JS or with reduced motion. */
  .highlight.unlit {
    background-size: 0% 100%;
    transition: none;
  }
  .org {
    min-width: 0;
    background: var(--color-cotton);
    color: var(--color-ink);
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius-md);
  }
  .org p {
    margin-top: 12px;
    color: var(--color-ink-soft);
  }
  .org ul {
    margin: 16px 0 0;
    padding-left: 1.1em;
    list-style: disc;
    color: var(--color-ink-soft);
  }
  .org li + li {
    margin-top: 6px;
  }
  .link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding-inline: 10px;
    color: var(--color-gold);
    font-weight: 600;
    font-size: var(--text-label);
    line-height: 1.3;
    text-align: center;
  }
  .link svg {
    width: 100%;
    height: 40px;
    overflow: visible;
  }
  /* The diamond runs along the arrow twice, then comes to rest in the middle. */
  @keyframes support-flow {
    0% {
      transform: translateX(-48px);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    40% {
      transform: translateX(48px);
      opacity: 1;
    }
    44% {
      transform: translateX(48px);
      opacity: 0;
    }
    45% {
      transform: translateX(-48px);
      opacity: 0;
    }
    52% {
      opacity: 1;
    }
    82% {
      transform: translateX(48px);
      opacity: 1;
    }
    86% {
      transform: translateX(48px);
      opacity: 0;
    }
    88% {
      transform: translateX(0);
      opacity: 0;
    }
    100% {
      transform: translateX(0);
      opacity: 1;
    }
  }
  /* Set only by the script, so the diamond rests in place without JS or with reduced motion. */
  .link.flow .runner {
    animation: support-flow 3.4s cubic-bezier(0.45, 0, 0.25, 1) both;
  }
  @media (max-width: 900px) {
    .link {
      flex-direction: row;
      padding-block: 14px;
    }
    .link svg {
      width: 40px;
      height: 56px;
      transform: rotate(90deg);
    }
  }
</style>
