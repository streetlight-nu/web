---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import LightBand from "@/components/LightBand.astro";
import Pil from "@/components/Pil.astro";
import Repejo from "@/components/Repejo.astro";
import Steps from "@/components/Steps.astro";
import TjugoLjus from "@/components/TjugoLjus.astro";
import { buttonVariants } from "@/components/ui/button";
import Julvaxel from "@/components/Julvaxel.astro";
import { hamtaJulinsamling } from "@/lib/julinsamling";
import { hamtaJulkampanj } from "@/lib/julkampanj";
import { SWISH_KORTKOD } from "@/lib/repejo";
import { href } from "@/lib/utils";
import julpaketKort from "@/assets/julklapp/julpaket-kort.png";
import barnITradgarden from "@/assets/julklapp/barn-i-tradgarden.jpg";

/**
 * Ge ett julpaket: the Christmas campaign. A visitor gives a julpaket to the children in Addis Abeba
 * and the association sends a julkort in their name on Christmas morning. Repejo handles the
 * checkout and the progress bar (ADR 0003). The campaign's own facts come from
 * src/data/julkampanj.json (Pages CMS); an empty field is not shown.
 * Seasonal (src/lib/julinsamling.ts): the page is always there, but the julpaket checkout, the progress bar and the
 * three steps are shown only while the Julinsamling runs. Before and after it, the page says so and holds
 * Repejo's Swish checkout for a one-off gift.
 */
const { vadJulklappenGor } = hamtaJulkampanj();
const { startText, slutText } = hamtaJulinsamling();

/** What the page says outside the Julinsamling, per state. */
const status = {
  innan: `Insamlingen Ge ett julpaket startar ${startText}. Tills dess kan du ge en engångsgåva via Swish.`,
  avslutad: "Insamlingen Ge ett julpaket är avslutad. Du kan fortfarande ge en engångsgåva via Swish.",
  ingen: "Du kan ge en engångsgåva via Swish.",
};
/** The same all year, because the page is built once and the Julinsamling starts and ends in the browser. */
const beskrivning =
  "Ge ett julpaket till barnen i Addis Abeba och gläd samtidigt någon du tycker om. Under insamlingen Ge ett julpaket skickar vi ett julkort via sms i ditt namn på julaftonsmorgonen. Du kan också ge en gåva via Swish.";

const section = "py-[clamp(64px,9vw,120px)]";
const h2 = "text-headline";
const split = "grid grid-cols-1 gap-[clamp(32px,6vw,72px)] min-[901px]:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]";
---

<BaseLayout
  title="Ge ett julpaket"
  current="julklapp"
  description={beskrivning}
>
  <Repejo slot="head" del="skript" />

  <div
    slot="header"
    class={`${split} items-start pt-[clamp(28px,5vw,56px)] pb-[clamp(56px,8vw,104px)] min-[901px]:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]`}
  >
    <div class="min-w-0">
      <Julvaxel>
        <Fragment slot="pagar">
          <h1 class="max-w-[14ch] text-[clamp(2.2rem,5.4vw,4.6rem)] leading-[0.98] tracking-[-0.035em]">
            Ge ett julpaket som sprider <span class="text-gold">hopp</span>
          </h1>
          <p class="mt-[22px] max-w-[40ch] text-lede text-mint">
            Den här julen kan du ge ett julpaket till barnen i Addis Abeba och samtidigt glädja någon du tycker om.
          </p>
          <p class="mt-3.5 max-w-[42ch]">
            Du väljer ett belopp, skriver ett digitalt julkort och vi skickar det via sms i ditt namn på julaftonsmorgonen.
          </p>
          <div class="mt-[30px] flex flex-wrap gap-3.5">
            <a class={buttonVariants()} href="#ge">Ge ett julpaket <Pil /></a>
          </div>
          <section aria-label="Insamlingsmålet" class="mt-[clamp(32px,4vw,48px)] max-w-[46ch]">
            <p class="font-semibold text-mint">Så långt har vi kommit mot insamlingsmålet</p>
            <div class="mt-3"><Repejo del="matare" /></div>
          </section>
        </Fragment>
        <Fragment slot="innan">
          <h1 class="max-w-[14ch] text-[clamp(2.2rem,5.4vw,4.6rem)] leading-[0.98] tracking-[-0.035em]">Ge ett julpaket startar snart</h1>
          <p class="mt-[22px] max-w-[40ch] text-lede text-mint">{status.innan}</p>
          <div class="mt-[30px] flex flex-wrap gap-3.5">
            <a class={buttonVariants()} href="#ge">Ge en gåva via Swish <Pil /></a>
          </div>
        </Fragment>
        <Fragment slot="avslutad">
          <h1 class="max-w-[14ch] text-[clamp(2.2rem,5.4vw,4.6rem)] leading-[0.98] tracking-[-0.035em]">Ge ett julpaket är avslutat</h1>
          <p class="mt-[22px] max-w-[40ch] text-lede text-mint">{status.avslutad}</p>
          <div class="mt-[30px] flex flex-wrap gap-3.5">
            <a class={buttonVariants()} href="#ge">Ge en gåva via Swish <Pil /></a>
          </div>
        </Fragment>
        <Fragment slot="ingen">
          <h1 class="max-w-[14ch] text-[clamp(2.2rem,5.4vw,4.6rem)] leading-[0.98] tracking-[-0.035em]">Ge en gåva via Swish</h1>
          <p class="mt-[22px] max-w-[40ch] text-lede text-mint">{status.ingen}</p>
          <div class="mt-[30px] flex flex-wrap gap-3.5">
            <a class={buttonVariants()} href="#ge">Ge en gåva via Swish <Pil /></a>
          </div>
        </Fragment>
      </Julvaxel>
    </div>

    <div class="min-w-0">
      <Image
        class="kort block w-full max-w-[560px] rounded-md shadow-[0_24px_48px_-12px_rgba(4,26,19,0.55)] min-[901px]:ml-auto"
        src={julpaketKort}
        alt="Julkort med texten ”God jul!”. Bredvid texten ett brunt paket med lapp där det står Addis Abeba, förseglat med rött vax. Nederst ”Ett julpaket i ditt namn” och Streetlights logotyp."
        widths={[480, 960, 1200]}
        sizes="(min-width: 592px) 560px, 100vw"
        loading="eager"
      />
    </div>
  </div>

  <LightBand utanText />

  <!-- While the Julinsamling runs: the three steps and the julpaket checkout in one section, the steps tell what
       happens, Repejo does it. Before and after: Repejo's Swish checkout for a one-off gift. -->
  <section id="ge" aria-labelledby="ge-rubrik" class={`scroll-mt-4 border-b border-rule bg-white text-ink ${section}`}>
    <div class={`band-inner ${split} items-start min-[901px]:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]`}>
      <Julvaxel>
        <Fragment slot="pagar">
          <div class="min-w-0">
            <h2 id="ge-rubrik" class={h2}>Ge ett julpaket</h2>
            {slutText && <p class="mt-[22px] max-w-[40ch] font-semibold">Sista insamlingsdag är {slutText}.</p>}
            <Steps class="steg mt-[clamp(28px,4vw,40px)]" aria-labelledby="ge-rubrik">
              <li>
                <h3 class="stegrubrik">Välj ett belopp</h3>
                <p>Du bestämmer själv hur mycket du vill ge. Allt går till barnen och familjerna i Addis Abeba.</p>
              </li>
              <li>
                <h3 class="stegrubrik">Skriv ett digitalt julkort</h3>
                <p>Skriv en hälsning till den du vill glädja: en vän, en granne, mormor eller en kollega.</p>
              </li>
              <li>
                <h3 class="stegrubrik">Vi skickar det på julaftonsmorgonen</h3>
                <p>Julkortet kommer digitalt via ett sms i ditt namn. Du behöver inte göra något mer.</p>
              </li>
            </Steps>
          </div>
          <Repejo del="checkout" />
        </Fragment>
        <Fragment slot="innan">
          <div class="min-w-0">
            <h2 id="ge-rubrik" class={h2}>Ge en gåva via Swish</h2>
            <p class="mt-[22px] max-w-[40ch]">{status.innan}</p>
            <p class="mt-3.5 max-w-[40ch] text-ink-soft">Allt går till barnen och familjerna i Addis Abeba.</p>
          </div>
          <div class="swish">
            <Repejo del="checkout" kortkod={SWISH_KORTKOD} vantar="Här visas Repejos formulär för att swisha en gåva." />
          </div>
        </Fragment>
        <Fragment slot="avslutad">
          <div class="min-w-0">
            <h2 id="ge-rubrik" class={h2}>Ge en gåva via Swish</h2>
            <p class="mt-[22px] max-w-[40ch]">{status.avslutad}</p>
            <p class="mt-3.5 max-w-[40ch] text-ink-soft">Allt går till barnen och familjerna i Addis Abeba.</p>
          </div>
          <div class="swish">
            <Repejo del="checkout" kortkod={SWISH_KORTKOD} vantar="Här visas Repejos formulär för att swisha en gåva." />
          </div>
        </Fragment>
        <Fragment slot="ingen">
          <div class="min-w-0">
            <h2 id="ge-rubrik" class={h2}>Ge en gåva via Swish</h2>
            <p class="mt-[22px] max-w-[40ch]">{status.ingen}</p>
            <p class="mt-3.5 max-w-[40ch] text-ink-soft">Allt går till barnen och familjerna i Addis Abeba.</p>
          </div>
          <div class="swish">
            <Repejo del="checkout" kortkod={SWISH_KORTKOD} vantar="Här visas Repejos formulär för att swisha en gåva." />
          </div>
        </Fragment>
      </Julvaxel>
    </div>
  </section>

  <section aria-labelledby="vart-rubrik" class={`bg-cotton text-ink ${section}`}>
    <div class={`band-inner ${split} items-start`}>
      <div class="min-w-0">
        <h2 id="vart-rubrik" class={h2}>
          <Julvaxel>
            <Fragment slot="pagar">Vart julpaketet går</Fragment>
            <Fragment slot="annars">Vart pengarna går</Fragment>
          </Julvaxel>
        </h2>
        <div class="mt-8 max-w-[52ch] space-y-3 text-ink-soft">
          <p><TjugoLjus tone="ink" /></p>
          <p>
            Streetlight stöttar 20 fadderbarn med skolgång samt deras familjer i Addis Abeba. Barnen väljs ut tillsammans
            med de lokala myndigheterna och Streetlight Etiopien bär arbetet med barnen och familjerna på plats.
          </p>
        </div>
        {
          vadJulklappenGor && (
            <Julvaxel>
              <div slot="pagar" class="mt-6 max-w-[52ch] rounded-md border border-rule bg-white p-6">
                <h3 class="stegrubrik">Det här finns i julpaketet</h3>
                <p class="mt-2">{vadJulklappenGor}</p>
              </div>
            </Julvaxel>
          )
        }
        <Julvaxel>
          <p slot="pagar" class="mt-4 max-w-[52ch]">
            När alla 20 julpaket är klara fördelas överskottet till familjerna där det bäst behövs.
          </p>
        </Julvaxel>
        <p class="mt-3 max-w-[52ch] text-ink-soft">
          Vill du göra mer? {" "}
          <a class="font-semibold text-ink underline" href={href("/bli-fadder")}>Läs om att bli fadder</a>.
        </p>
      </div>
      <Image
        class="block aspect-[4/3] w-full rounded-md object-cover min-[901px]:sticky min-[901px]:top-8"
        src={barnITradgarden}
        alt="Barn och ungdomar i en grönskande trädgård i Addis Abeba. Några i förgrunden tar en selfie och ler mot kameran, och en av dem visar tummen upp."
        widths={[440, 880, 1320]}
        sizes="(min-width: 901px) 560px, 100vw"
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* The julkort lies a little askew on wide screens, and straight on a phone. */
  .kort {
    transform: rotate(-2.5deg);
  }
  @media (max-width: 760px) {
    .kort {
      transform: none;
    }
  }
  .stegrubrik {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lede);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  ol.steg {
    gap: 24px;
  }
  /* Repejo's Swish card is shorter than a checkout with card fields: reserve about its first step. */
  .swish {
    min-width: 0;
    max-width: 520px;
  }
  .swish :global(repejo-checkout) {
    min-height: 380px;
  }
  .steg p {
    margin-top: 6px;
    max-width: 40ch;
    color: var(--color-ink-soft);
  }
</style>
