---
/**
 * The old address of Bli fadder. The page moved to /bli-fadder; this page sends a visitor with an old link or bookmark
 * there, anchor included (for example /stod-oss#fler). The site is static (GitHub Pages), so the redirect is a meta
 * refresh plus a script that keeps the anchor, and a link for when neither runs.
 */
import { href } from "@/lib/utils";

const mal = href("/bli-fadder");
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Bli fadder | Streetlight</title>
    <link rel="canonical" href={new URL(mal, Astro.site).href} />
    <meta http-equiv="refresh" content={`0; url=${mal}`} />
    <script is:inline define:vars={{ mal }}>
      location.replace(mal + location.hash);
    </script>
  </head>
  <body>
    <p>Sidan har flyttat till <a href={mal}>Bli fadder</a>.</p>
  </body>
</html>
